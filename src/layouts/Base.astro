---
import "../styles/global.css";
import buildInfo from "../generated/build-info.json";
import Logo from "../components/Logo.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The sticky "Book a call" button. Off on /thanks, where the visitor is already booking. */
  cta?: boolean;
}

const { title = "Arcbuildr", description, noindex = false, cta = true } = Astro.props;

// Cloudflare Web Analytics, cookieless. Needs the site token from the dashboard; without it, no beacon.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const navLinks = [
  { label: "Method", href: "/method" },
  { label: "Notes", href: "/notes" },
  { label: "About", href: "/about" },
];
// Static builds give "/privacy/", dev gives "/privacy".
const here = Astro.url.pathname.replace(/(.)\/$/, "$1");
const currentPage = (href: string) => (here === href ? "page" : undefined);

// Preview-only build line. Unknown branch counts as main, so it stays hidden.
const showBuild = !["main", "unknown", ""].includes(buildInfo.branch);
// Previews are never indexed. /thanks and other private pages pass `noindex`.
const hideFromSearch = noindex || showBuild;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Before first paint: mark JS (reveals may hide below-fold content) and, on the first
      // home visit of the session, play the intro. Reduced motion never gets it.
      (() => {
        const html = document.documentElement;
        html.classList.add("js");
        try {
          const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (location.pathname === "/" && !calm && !sessionStorage.getItem("arc-intro")) {
            html.classList.add("intro");
            sessionStorage.setItem("arc-intro", "1");
          }
        } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {hideFromSearch && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Arcbuildr" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <noscript>
      <style>
        .site-header__cta.is-quiet {
          translate: none;
          visibility: visible;
        }
      </style>
    </noscript>
  </head>
  <body class:list={[{ "has-dock": cta }]}>
    {analyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
    {isHome && (
      <div class="intro-curtain" aria-hidden="true">
        <div class="intro-curtain__mark">
          <svg viewBox="0 0 100 66">
            <path
              d="M18 52 A 32 32 0 0 1 82 52"
              fill="none"
              stroke="currentColor"
              stroke-width="18"
              stroke-linecap="round"
            ></path>
          </svg>
          <span class="intro-curtain__word">
            {[..."arcbuildr"].map((c, i) => (
              <span style={`--i: ${i}`}>{c}</span>
            ))}
          </span>
        </div>
      </div>
    )}
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="site-header__pill">
        <Logo />
        <nav class="site-header__nav" aria-label="Main">
          {navLinks.map(({ label, href }) => (
            <a href={href} aria-current={currentPage(href)}>
              {label}
            </a>
          ))}
        </nav>
        <button class="site-header__menu" type="button" popovertarget="site-menu">
          Menu
        </button>
        {cta && (
          <a class="btn site-header__cta is-quiet" href="/#start">
            Book a call
          </a>
        )}
      </div>
      <div id="site-menu" class="site-menu" popover>
        <nav aria-label="Mobile">
          {navLinks.map(({ label, href }) => (
            <a href={href} aria-current={currentPage(href)}>
              {label}
            </a>
          ))}
          <a class="btn" href="/#start">
            Book a call
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="site-footer__panel">
        <Logo />
        <ul class="site-footer__links">
          <li>
            <a href="/privacy" aria-current={currentPage("/privacy")}>
              Privacy
            </a>
          </li>
        </ul>
        <p class="site-footer__small">© 2026 Arcbuildr</p>
        {showBuild && (
          <p class="site-footer__small" data-build>
            Preview build: {buildInfo.branch} ({buildInfo.branchSource}) {buildInfo.commit}
          </p>
        )}
      </div>
    </footer>
    <script is:inline>
      // Tap or key skips the intro.
      (() => {
        const html = document.documentElement;
        if (!html.classList.contains("intro")) return;
        const end = () => html.classList.remove("intro");
        addEventListener("pointerdown", end, { once: true });
        addEventListener("keydown", end, { once: true });
        setTimeout(end, 2600);
      })();
      // Header pill closes inward once the page leaves the top (CSS limits it to narrow screens).
      (() => {
        const html = document.documentElement;
        const set = () => html.classList.toggle("is-scrolled", scrollY > 24);
        addEventListener("scroll", set, { passive: true });
        set();
      })();
      // Reveal on scroll. Already on screen: shown at once, with no transition.
      (() => {
        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window))
          return els.forEach((e) => e.classList.add("is-in"));
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        for (const e of els) {
          const r = e.getBoundingClientRect();
          if (r.top < innerHeight && r.bottom > 0) e.classList.add("is-in", "is-instant");
          else io.observe(e);
        }
      })();
    </script>
  </body>
</html>

<script>
  // Dead code on main: the define in astro.config.mjs makes this false and Vite drops the import.
  if (__PREVIEW__) import("../components/mountFeedback");
</script>

<script>
  // Mobile dock: the header CTA floats at the bottom, but steps aside while the hero button or the form is on screen.
  const dock = document.querySelector(".site-header__cta");
  const targets = document.querySelectorAll(".hero__action, #start");
  // Starts quiet so it never flashes in over the hero; pages without a hero or form show it at once.
  if (dock && !targets.length) dock.classList.remove("is-quiet");
  if (dock && targets.length) {
    const seen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      dock.classList.toggle("is-quiet", seen.size > 0);
    });
    targets.forEach((t) => io.observe(t));
  }
</script>

<style is:global>
  main {
    flex: 1;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    padding: var(--space-sm) var(--gutter) 0;
    pointer-events: none;
  }
  .site-header__pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    max-width: 56rem;
    padding: 0.375rem 0.375rem 0.375rem var(--space-lg);
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-lift);
    pointer-events: auto;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    text-decoration: none;
  }
  /* The brand arc (arcbuildr-symbol.svg) and the orange "r", set live in Open Runde. */
  .wordmark__arc {
    width: 1.35em;
    height: auto;
    color: var(--color-accent);
    translate: 0 -0.06em;
  }
  .wordmark__r {
    color: var(--color-accent);
  }
  .site-header__pill .btn {
    min-height: var(--tap);
    padding-inline: var(--space-lg);
  }
  .site-header__nav {
    display: flex;
    gap: var(--space-2xs);
  }
  .site-header__nav a,
  .site-menu nav > a,
  .site-footer__links a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--text-lg);
    text-decoration: none;
  }
  /* Hover and the current page: a soft pill, no underline (context-con mechanic). */
  .site-header__nav a,
  .site-footer__links a {
    padding-inline: var(--space-sm);
    border-radius: var(--radius-pill);
    color: color-mix(in oklab, var(--color-paper) 80%, transparent);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"],
  .site-footer__links a:hover,
  .site-footer__links a[aria-current="page"] {
    color: var(--color-paper);
    background: color-mix(in oklab, var(--color-paper) 12%, transparent);
  }
  .site-menu nav > a:not(.btn):hover,
  .site-menu nav > a[aria-current="page"] {
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
  }
  .site-header__menu {
    display: none;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 var(--space-lg);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-lg);
    font-weight: 600;
    cursor: pointer;
  }
  .site-menu {
    position: fixed;
    inset: 5.5rem var(--gutter) auto auto;
    width: min(24rem, calc(100% - 2 * var(--gutter)));
    max-height: calc(100dvh - 7rem);
    margin: 0;
    padding: var(--space-lg);
    border: var(--rule-thin);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    color: var(--color-ink);
    box-shadow: var(--shadow-lift);
    pointer-events: auto;
  }
  .site-menu nav {
    display: grid;
    gap: var(--space-xs);
  }
  .site-menu nav > a:not(.btn) {
    padding-inline: var(--space-sm);
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .site-menu::backdrop {
    background: color-mix(in oklab, var(--color-ink) 15%, transparent);
  }
  @media (min-width: 64rem) {
    .site-menu:popover-open {
      display: none;
    }
  }

  /* Phones and small laptops: the pill fits its content and closes inward once the page
   * leaves the top (the links fold away, Menu unfolds), then opens again back at the top.
   * Widths and opacity only; folded parts are also hidden from focus. */
  @media (width < 64rem) {
    .site-header__pill {
      width: fit-content;
      max-width: 100%;
      gap: 0;
    }
    .site-header__nav,
    .site-header__menu {
      overflow: hidden;
      white-space: nowrap;
      transition:
        max-width 0.3s var(--ease-out),
        margin 0.3s var(--ease-out),
        padding 0.3s var(--ease-out),
        opacity 0.3s var(--ease-out),
        visibility 0s;
    }
    .site-header__nav {
      max-width: 20rem;
      margin-left: var(--space-sm);
    }
    /* overflow: hidden would clip the focus ring, so draw it inside. */
    .site-header__nav a:focus-visible {
      outline-offset: -3px;
    }
    .site-header__menu {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      max-width: 0;
      min-width: 0;
      margin-left: 0;
      padding-inline: 0;
      opacity: 0;
      visibility: hidden;
      transition-property: max-width, margin, padding, opacity, visibility;
      transition-delay: 0s, 0s, 0s, 0s, 0.3s;
    }
    .site-header__pill .site-header__cta {
      margin-left: var(--space-sm);
    }
    .is-scrolled .site-header__nav {
      max-width: 0;
      margin-left: 0;
      opacity: 0;
      visibility: hidden;
      transition-delay: 0s, 0s, 0s, 0s, 0.3s;
    }
    .is-scrolled .site-header__menu {
      max-width: 8rem;
      min-width: var(--tap);
      margin-left: var(--space-sm);
      padding-inline: var(--space-lg);
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
    .site-menu:popover-open {
      animation: menu-enter var(--dur-fast) var(--ease-out);
    }
  }

  @media (width < 48rem) {
    /* Logo plus three links must fit a 375 px screen at the top. */
    .site-header {
      padding-inline: var(--space-sm);
    }
    .site-header__pill {
      padding-left: var(--space-md);
    }
    .site-header__nav {
      margin-left: var(--space-2xs);
    }
    .site-header__nav a {
      padding-inline: 0.4rem;
      font-size: var(--text-sm);
    }
    .site-header__cta {
      position: fixed;
      left: 0;
      right: 0;
      bottom: max(var(--space-md), env(safe-area-inset-bottom));
      width: fit-content;
      margin-inline: auto;
      min-height: 3.25rem !important;
      padding-inline: var(--space-xl) !important;
      box-shadow: var(--shadow-lift);
      /* Slides, never fades: a half-transparent button would fail contrast mid-transition. */
      transition:
        translate var(--dur-fast) var(--ease-out),
        visibility 0s;
    }
    .site-header__cta.is-quiet {
      translate: 0 calc(100% + 2rem);
      visibility: hidden;
      transition:
        translate var(--dur-fast) var(--ease-out),
        visibility 0s linear var(--dur-fast);
    }
    .has-dock .site-footer {
      padding-bottom: 5.5rem;
    }
  }
  @media (width < 22rem) {
    .site-header .wordmark {
      font-size: 1.05rem;
    }
    .site-header__nav a {
      padding-inline: 0.3rem;
    }
  }
  @keyframes menu-enter {
    from {
      translate: 0 var(--space-sm);
    }
    to {
      translate: 0 0;
    }
  }

  .site-footer {
    margin-top: var(--space-3xl);
    padding-bottom: var(--space-md);
  }
  .site-footer__panel {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links li,
  .site-footer__links a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
  }
  .site-footer__small {
    color: #b5aea6;
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    .site-footer__panel {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-xl);
      padding: var(--space-2xl) var(--space-2xl) var(--space-xl);
    }
    .site-footer__links {
      grid-row: 1 / span 2;
      grid-column: 2;
      flex-direction: row;
      gap: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu:popover-open {
      animation: none;
    }
    .site-header__pill,
    .site-header__nav,
    .site-header__menu,
    .site-header__nav a,
    .site-footer__links a {
      transition: none !important;
    }
    .site-header__cta {
      transition: none !important;
    }
  }
</style>
