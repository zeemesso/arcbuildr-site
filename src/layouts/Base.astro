---
/**
 * Every page that is not the home page: the home page's layout with the same header and footer around
 * the page's own words (DESIGN.md, section 17). A text page puts its words in `.prose` (prose.css).
 */
import Home from "./Home.astro";
import Bar from "../components/page/Bar.astro";
import Foot from "../components/page/Foot.astro";
import { meta } from "../content/site";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** False where there is nothing to apply to: a magnet page, the plan page, unsubscribe. */
  apply?: boolean;
  /** False where the address holds a private link (the plan page): the visit counter never sees it. */
  analytics?: boolean;
}
const {
  title = meta.title,
  description = meta.description,
  noindex = false,
  apply = true,
  analytics = true,
} = Astro.props;
---

<Home title={title} description={description} noindex={noindex} analytics={analytics}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <Bar slot="bar" cta={apply} form={false} />
  <slot />
  <Foot slot="after" />
</Home>
