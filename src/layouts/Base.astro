---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/look.css";
import "../styles/sections.css";
import { meta } from "../content/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** False on the booking confirmation: someone who has booked is not asked to apply again. */
  apply?: boolean;
}
const {
  title = meta.title,
  description = meta.description,
  noindex = false,
  apply = true,
} = Astro.props;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Motion is extra. If the page script has not started after 3 seconds, show everything as if there were no script.
      ((root) => {
        root.classList.add("js");
        setTimeout(() => root.classList.contains("ready") || root.classList.remove("js"), 3000);
      })(document.documentElement);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f3f0" />
    {(noindex || __PREVIEW__) && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/open-runde-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/open-runde-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip" href="#main">
      {meta.skip}
    </a>
    <Header apply={apply} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {analyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
<script>
  import "../scripts/motion";
  if (__PREVIEW__) import("../components/mountFeedback");
</script>
