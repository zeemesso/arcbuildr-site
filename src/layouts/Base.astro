---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/look.css";
import "../styles/sections.css";
import { meta } from "../content/site";
import Head from "./Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** False on the booking confirmation: someone who has booked is not asked to apply again. */
  apply?: boolean;
}
const {
  title = meta.title,
  description = meta.description,
  noindex = false,
  apply = true,
} = Astro.props;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a class="skip" href="#main">
      {meta.skip}
    </a>
    <Header apply={apply} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {analyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
<script>
  import "../scripts/motion";
  if (__PREVIEW__) import("../components/mountFeedback");
</script>
