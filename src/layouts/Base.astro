---
import "../styles/global.css";
import buildInfo from "../generated/build-info.json";
import Logo from "../components/Logo.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The sticky "Book a call" button. Off on /thanks, where the visitor is already booking. */
  cta?: boolean;
}

const { title = "Arcbuildr", description, noindex = false, cta = true } = Astro.props;

// Cloudflare Web Analytics, cookieless. Needs the site token from the dashboard; without it, no beacon.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const navLinks = [
  { label: "Method", href: "/method" },
  { label: "Notes", href: "/notes" },
  { label: "About", href: "/about" },
];
// Static builds give "/privacy/", dev gives "/privacy".
const here = Astro.url.pathname.replace(/(.)\/$/, "$1");
const currentPage = (href: string) => (here === href ? "page" : undefined);

// Preview-only build line. Unknown branch counts as main, so it stays hidden.
const showBuild = !["main", "unknown", ""].includes(buildInfo.branch);
// Previews are never indexed. /thanks and other private pages pass `noindex`.
const hideFromSearch = noindex || showBuild;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Before first paint: mark JS (reveals may hide below-fold content) and, on the first
      // home visit of the session, play the intro. Reduced motion never gets it.
      (() => {
        const html = document.documentElement;
        html.classList.add("js");
        try {
          const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (location.pathname === "/" && !calm && !sessionStorage.getItem("arc-intro")) {
            html.classList.add("intro");
            sessionStorage.setItem("arc-intro", "1");
          }
        } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {hideFromSearch && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Arcbuildr" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    {analyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
    {isHome && (
      <div class="intro-curtain" aria-hidden="true">
        <div class="intro-curtain__mark">
          <svg viewBox="0 0 100 66">
            <path
              d="M18 52 A 32 32 0 0 1 82 52"
              fill="none"
              stroke="currentColor"
              stroke-width="18"
              stroke-linecap="round"
            ></path>
          </svg>
          <span class="intro-curtain__word">
            {[..."arcbuildr"].map((c, i) => (
              <span style={`--i: ${i}`}>{c}</span>
            ))}
          </span>
        </div>
      </div>
    )}
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="site-header__pill">
        <Logo />
        <nav class="site-header__nav" aria-label="Main">
          <div class="site-header__links">
            {navLinks.map(({ label, href }) => (
              <a href={href} aria-current={currentPage(href)}>
                {label}
              </a>
            ))}
          </div>
        </nav>
        {cta && (
          <a class="btn site-header__cta" href="/#start">
            Book a call
          </a>
        )}
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="site-footer__panel">
        <Logo />
        <ul class="site-footer__links">
          <li>
            <a href="/privacy" aria-current={currentPage("/privacy")}>
              Privacy
            </a>
          </li>
        </ul>
        <p class="site-footer__small">© 2026 Arcbuildr</p>
        {showBuild && (
          <p class="site-footer__small" data-build>
            Preview build: {buildInfo.branch} ({buildInfo.branchSource}) {buildInfo.commit}
          </p>
        )}
      </div>
    </footer>
    <script is:inline>
      // Tap or key skips the intro.
      (() => {
        const html = document.documentElement;
        if (!html.classList.contains("intro")) return;
        const end = () => html.classList.remove("intro");
        addEventListener("pointerdown", end, { once: true });
        addEventListener("keydown", end, { once: true });
        setTimeout(end, 2600);
      })();
      // A reload starts at the top. A link to an anchor (/#start) still lands on it.
      (() => {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        if (!location.hash) scrollTo(0, 0);
      })();
      // Header pill closes inward once the page leaves the top (CSS limits it to narrow screens).
      (() => {
        const html = document.documentElement;
        const set = () => html.classList.toggle("is-scrolled", scrollY > 24);
        addEventListener("scroll", set, { passive: true });
        set();
      })();
      // Reveal on scroll. Already on screen: shown at once, with no transition.
      (() => {
        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window))
          return els.forEach((e) => e.classList.add("is-in"));
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        for (const e of els) {
          const r = e.getBoundingClientRect();
          if (r.top < innerHeight && r.bottom > 0) e.classList.add("is-in", "is-instant");
          else io.observe(e);
        }
      })();
    </script>
  </body>
</html>

<script>
  // Dead code on main: the define in astro.config.mjs makes this false and Vite drops the import.
  if (__PREVIEW__) import("../components/mountFeedback");
</script>

<style is:global>
  main {
    flex: 1;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    padding: var(--space-sm) var(--gutter) 0;
    pointer-events: none;
  }
  .site-header__pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    max-width: 56rem;
    padding: 0.375rem 0.375rem 0.375rem var(--space-lg);
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-lift);
    pointer-events: auto;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    text-decoration: none;
  }
  /* The brand arc (arcbuildr-symbol.svg) and the orange "r", set live in Open Runde. */
  .wordmark__arc {
    width: 1.35em;
    height: auto;
    color: var(--color-accent);
    translate: 0 -0.06em;
  }
  .wordmark__r {
    color: var(--color-accent);
  }
  .site-header__pill .btn {
    min-height: var(--tap);
    padding-inline: var(--space-lg);
  }
  .site-header__links {
    display: flex;
    gap: var(--space-2xs);
  }
  .site-header__nav a,
  .site-footer__links a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--text-lg);
    text-decoration: none;
  }
  /* Hover and the current page: a soft pill, no underline (context-con mechanic). */
  .site-header__nav a,
  .site-footer__links a {
    padding-inline: var(--space-sm);
    border-radius: var(--radius-pill);
    color: color-mix(in oklab, var(--color-paper) 80%, transparent);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"],
  .site-footer__links a:hover,
  .site-footer__links a[aria-current="page"] {
    color: var(--color-paper);
    background: color-mix(in oklab, var(--color-paper) 12%, transparent);
  }

  /* Below 64rem: at the top the pill shows everything, at every width; once the page leaves the
   * top it closes inward to the favicon tile and the button (context-con mechanic), and opens again
   * at the top. The pill is centred and sized by its content, so both edges move together.
   * The wordmark text and the links fold by a grid track (1fr to 0fr), which animates to their
   * exact width: no overshoot, no jump. Folded parts leave the tab order (visibility, delayed).
   * The button never changes, so its contrast never dips. */
  @media (width < 64rem) {
    .site-header {
      --fold: 0.3s cubic-bezier(0, 0, 0.2, 1);
    }
    .site-header__pill {
      width: fit-content;
      max-width: 100%;
      gap: 0;
      padding-left: var(--space-md);
      transition: padding var(--fold);
    }
    .site-header__pill > * {
      flex: none;
    }
    .site-header .wordmark {
      gap: 0;
    }
    .site-header .wordmark__arc {
      height: 0.9em;
      border-radius: 0.6rem;
      transition:
        width var(--fold),
        height var(--fold),
        padding var(--fold),
        translate var(--fold),
        background-color var(--fold),
        color var(--fold);
    }
    .site-header .wordmark__text,
    .site-header__nav {
      display: grid;
      grid-template: 1fr / 1fr;
      transition:
        grid-template-columns var(--fold),
        grid-template-rows var(--fold),
        margin var(--fold),
        opacity var(--fold),
        visibility 0s;
    }
    .site-header .wordmark__text > span,
    .site-header__links {
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      white-space: nowrap;
    }
    .site-header .wordmark__text {
      margin-left: var(--space-xs);
    }
    .site-header__nav {
      margin-left: var(--space-xs);
    }
    /* overflow: hidden would clip the focus ring, so draw it inside. */
    .site-header__nav a:focus-visible {
      outline-offset: -3px;
    }
    .site-header__pill .site-header__cta {
      margin-left: var(--space-sm);
    }
    .is-scrolled .site-header__pill {
      padding-left: 0.375rem;
    }
    .is-scrolled .site-header .wordmark__arc {
      width: 2.75rem;
      height: 2.75rem;
      padding: 0.5rem;
      translate: 0 0;
      background-color: var(--color-accent);
      color: var(--color-on-accent);
    }
    .is-scrolled .site-header .wordmark__text,
    .is-scrolled .site-header__nav {
      grid-template: 0fr / 0fr;
      margin: 0;
      opacity: 0;
      visibility: hidden;
      transition-delay: 0s, 0s, 0s, 0s, 0.3s;
    }
  }

  /* Phones: smaller links so logo, links and button all fit at the top. */
  @media (width < 48rem) {
    .site-header {
      padding-inline: var(--space-sm);
    }
    .site-header__pill {
      padding-left: var(--space-sm);
    }
    .site-header__nav {
      margin-left: var(--space-2xs);
    }
    .site-header__links {
      gap: 0;
    }
    .site-header__nav a {
      padding-inline: 0.375rem;
      font-size: 0.8125rem;
    }
    .site-header__pill .site-header__cta {
      margin-left: var(--space-2xs);
    }
  }

  /* Small phones: the stacked lockup (arc above a small wordmark) and a smaller button without
   * the arrow. White on the orange (3.05:1) needs 19 px bold, which does not fit, so the button
   * text turns ink (5.6:1) at 15 px bold. Hover lightens the orange, since the darker hover
   * orange would drop ink below 4.5:1. */
  @media (width < 30rem) {
    .site-header .wordmark {
      flex-direction: column;
      justify-content: center;
      font-size: 0.75rem;
      letter-spacing: -0.03em;
      line-height: 1;
    }
    .site-header .wordmark__arc {
      width: 1.75rem;
      height: 1.15rem;
    }
    .site-header .wordmark__text {
      margin: 0.125rem 0 0;
    }
    .site-header__pill .site-header__cta {
      padding-inline: var(--space-sm);
      color: var(--color-ink);
      font-size: 0.9375rem;
    }
    .site-header__pill .site-header__cta:hover {
      background: color-mix(in oklab, var(--color-accent) 85%, white);
    }
    .site-header__pill .site-header__cta::after {
      content: none;
    }
  }
  /* 320 to 375 px: tighter spacing and 12 px links. */
  @media (width < 24rem) {
    .site-header {
      padding-inline: var(--space-xs);
    }
    .site-header__pill {
      padding-left: var(--space-xs);
    }
    .site-header .wordmark {
      font-size: 0.6875rem;
    }
    .site-header .wordmark__arc {
      width: 1.6rem;
      height: 1.05rem;
    }
    .site-header__nav {
      margin-left: 0.125rem;
    }
    .site-header__nav a {
      padding-inline: 0.3125rem;
      font-size: var(--text-xs);
    }
    .site-header__pill .site-header__cta {
      margin-left: 0.125rem;
      padding-inline: 0.625rem;
    }
  }

  .site-footer {
    margin-top: var(--space-3xl);
    padding-bottom: var(--space-md);
  }
  .site-footer__panel {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links li,
  .site-footer__links a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
  }
  .site-footer__small {
    color: #b5aea6;
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    .site-footer__panel {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-xl);
      padding: var(--space-2xl) var(--space-2xl) var(--space-xl);
    }
    .site-footer__links {
      grid-row: 1 / span 2;
      grid-column: 2;
      flex-direction: row;
      gap: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__pill,
    .wordmark,
    .wordmark__arc,
    .wordmark__text,
    .site-header__nav,
    .site-header__nav a,
    .site-header__cta,
    .site-footer__links a {
      transition: none !important;
    }
  }
</style>
