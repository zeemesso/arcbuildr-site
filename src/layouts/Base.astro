---
import "../styles/global.css";
import buildInfo from "../generated/build-info.json";
import Logo from "../components/Logo.astro";
import logo from "../data/logo.json";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The sticky "Book a call" button. Off on /thanks, where the visitor is already booking. */
  cta?: boolean;
}

const { title = "Arcbuildr", description, noindex = false, cta = true } = Astro.props;

// Cloudflare Web Analytics, cookieless. Needs the site token from the dashboard; without it, no beacon.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const navLinks = [
  { label: "Method", href: "/method" },
  { label: "Notes", href: "/notes" },
  { label: "About", href: "/about" },
];
// Static builds give "/privacy/", dev gives "/privacy".
const here = Astro.url.pathname.replace(/(.)\/$/, "$1");
const currentPage = (href: string) => (here === href ? "page" : undefined);

// Preview-only build line. Unknown branch counts as main, so it stays hidden.
const showBuild = !["main", "unknown", ""].includes(buildInfo.branch);
// Previews are never indexed. /thanks and other private pages pass `noindex`.
const hideFromSearch = noindex || showBuild;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Before first paint: mark JS (reveals may hide below-fold content) and play the intro when
      // Home is entered from outside or reloaded, not when a visitor clicks back to it from inside
      // the site (Zyade, 2026-10-28). Reduced motion never gets it.
      // e2e sets sessionStorage "arc-intro" to skip it.
      (() => {
        const html = document.documentElement;
        html.classList.add("js");
        try {
          const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
          const nav = performance.getEntriesByType("navigation")[0];
          const inside =
            nav?.type === "back_forward" ||
            (nav?.type !== "reload" &&
              !!document.referrer &&
              new URL(document.referrer).origin === location.origin);
          if (
            location.pathname === "/" &&
            !calm &&
            !inside &&
            !sessionStorage.getItem("arc-intro")
          ) {
            html.classList.add("intro");
          }
        } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {hideFromSearch && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Arcbuildr" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    {analyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
    {isHome && (
      <div class="intro-curtain" aria-hidden="true">
        <div class="intro-curtain__mark">
          <svg class="intro-curtain__arc" viewBox={logo.arc.viewBox}>
            <path
              pathLength="1"
              d={logo.arc.d}
              fill="none"
              stroke="currentColor"
              stroke-width={logo.arc.stroke}
              stroke-linecap="round"
            ></path>
          </svg>
          <svg
            class="intro-curtain__word"
            viewBox={logo.word.viewBox}
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width={logo.stroke}
          >
            {logo.word.letters.map((d, i) => (
              <path pathLength="1" d={d} style={`--i: ${i}`} />
            ))}
          </svg>
        </div>
      </div>
    )}
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="site-header__pill">
        <Logo />
        <nav class="site-header__nav" aria-label="Main">
          <div class="site-header__links">
            {navLinks.map(({ label, href }) => (
              <a href={href} aria-current={currentPage(href)}>
                {label}
              </a>
            ))}
          </div>
        </nav>
        {cta && (
          <a class="btn site-header__cta" href="/#start">
            Book a call
          </a>
        )}
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="site-footer__panel">
        <Logo />
        <ul class="site-footer__links">
          <li>
            <a href="/privacy" aria-current={currentPage("/privacy")}>
              Privacy
            </a>
          </li>
        </ul>
        <p class="site-footer__small">© 2026 Arcbuildr</p>
        {showBuild && (
          <p class="site-footer__small" data-build>
            Preview build: {buildInfo.branch} ({buildInfo.branchSource}) {buildInfo.commit}
          </p>
        )}
      </div>
    </footer>
    <script is:inline>
      // Tap or key skips the intro.
      (() => {
        const html = document.documentElement;
        if (!html.classList.contains("intro")) return;
        const end = () => html.classList.remove("intro");
        addEventListener("pointerdown", end, { once: true });
        addEventListener("keydown", end, { once: true });
        setTimeout(end, 2600);
      })();
      // A reload starts at the top. A link to an anchor (/#start) still lands on it.
      (() => {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        if (!location.hash) scrollTo(0, 0);
      })();
      // Header pill closes inward once the page leaves the top (CSS limits it to narrow screens).
      (() => {
        const html = document.documentElement;
        const set = () => html.classList.toggle("is-scrolled", scrollY > 24);
        addEventListener("scroll", set, { passive: true });
        set();
      })();
      // Reveal on scroll. Already on screen: shown at once, with no transition.
      (() => {
        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window))
          return els.forEach((e) => e.classList.add("is-in"));
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        for (const e of els) {
          const r = e.getBoundingClientRect();
          if (r.top < innerHeight && r.bottom > 0) e.classList.add("is-in", "is-instant");
          else io.observe(e);
        }
      })();
    </script>
  </body>
</html>

<script>
  // Dead code on main: the define in astro.config.mjs makes this false and Vite drops the import.
  if (__PREVIEW__) import("../components/mountFeedback");
</script>

<style is:global>
  main {
    flex: 1;
  }

  /* Header: context-con's pill, measured at 390, 768, 1024 and 1280 px (docs/references/context-con.md).
   * A dark pill sized by its content and centred: logo, Method / Notes / About, "Book a call →".
   * Sizes are context-con's px written in em of a 14 px base, two steps: 48 px tall below 64rem,
   * 56 px from 64rem. Under ~412 px wide the base shrinks with the screen (our button text is longer
   * than theirs); under ~300 px the links track clips instead of pushing the button off screen.
   * Below 64rem, once the page leaves the top, the wordmark text and links close like a drawer:
   * their column shrinks to 0 (width only) with content pinned left, so the button slides over them
   * while the pill re-centres. The arc stays as the handle. From 64rem it never changes.
   * The button text is ink: white on this orange (3.05:1) fails AA at 14 px. */
  .site-header {
    --fold: 0.3s cubic-bezier(0, 0, 0.2, 1);
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    padding: 12px 12px 0;
    pointer-events: none;
  }
  .site-header__pill {
    display: flex;
    align-items: center;
    gap: 0.143em;
    width: fit-content;
    max-width: 100%;
    height: 3.43em;
    padding: 0 0.43em;
    font-size: 14px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.18);
    pointer-events: auto;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap);
    font-size: 1.3rem;
    text-decoration: none;
  }
  /* Round-capped arc and wordmark geometry from brand/build.mjs. */
  .wordmark__arc {
    width: 1.35em;
    height: auto;
    color: var(--color-accent);
    translate: 0 -0.06em;
  }
  .wordmark__word {
    display: block;
    height: 1.1em;
    width: auto;
  }
  .wordmark__r {
    color: var(--color-accent);
    stroke: var(--color-accent);
  }
  /* Header logo: 14 px word (16 from 40rem, 19 from 64rem), the scale of context-con's 18 / 20 / 24 px mark. */
  .site-header .wordmark {
    flex: none;
    gap: 0;
    min-height: 2.83em;
    padding: 0 0.157em 0 0.63em;
    font-size: 0.907em;
  }
  .site-header .wordmark__arc {
    width: 1.3em;
    height: 0.85em;
  }
  .site-header .wordmark__text {
    margin-left: 0.3em;
  }
  .site-header .wordmark__text,
  .site-header__nav {
    display: grid;
    grid-template-columns: 1fr;
    min-width: 0;
    transition:
      grid-template-columns var(--fold),
      margin var(--fold),
      opacity var(--fold),
      visibility 0s;
  }
  .site-header .wordmark__text > span,
  .site-header__links {
    display: flex;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .site-header__nav a {
    display: flex;
    align-items: center;
    height: 3em;
    padding-inline: 0.5em;
    border-radius: var(--radius-pill);
    color: color-mix(in oklab, var(--color-paper) 80%, transparent);
    font-size: 0.857em;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  /* overflow: hidden would clip the focus ring, so draw it inside. */
  .site-header__nav a:focus-visible {
    outline-offset: -3px;
  }
  .site-header__pill .site-header__cta {
    flex: none;
    min-height: 2.57em;
    padding-inline: 1.143em;
    color: var(--color-ink);
    font-size: 1em;
    font-weight: 600;
  }
  /* The darker hover orange would drop ink below 4.5:1, so hover lightens instead. */
  .site-header__pill .site-header__cta:hover {
    background: color-mix(in oklab, var(--color-accent) 85%, white);
  }
  /* Hover and the current page: a soft pill, no underline (context-con mechanic). */
  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"],
  .site-footer__links a:hover,
  .site-footer__links a[aria-current="page"] {
    color: var(--color-paper);
    background: color-mix(in oklab, var(--color-paper) 10%, transparent);
  }
  .site-footer__links a {
    padding-inline: var(--space-sm);
    border-radius: var(--radius-pill);
    color: color-mix(in oklab, var(--color-paper) 80%, transparent);
    font-size: var(--text-lg);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  @media (width >= 40rem) {
    .site-header .wordmark {
      font-size: 1.036em;
    }
  }
  @media (width < 40rem) {
    .site-header__pill {
      font-size: min(14px, 3.4vw);
    }
  }
  @media (width < 64rem) {
    .is-scrolled .site-header .wordmark__text,
    .is-scrolled .site-header__nav {
      grid-template-columns: 0fr;
      opacity: 0;
      visibility: hidden;
      transition-delay: 0s, 0s, 0s, 0.3s;
    }
    /* Closed, the empty word track keeps a gap so the arc sits as far from the button as from the edge. */
    .is-scrolled .site-header .wordmark__text {
      margin-left: 0.6em;
    }
  }
  @media (width >= 64rem) {
    .site-header {
      padding-top: 20px;
    }
    .site-header__pill {
      gap: 8px;
      height: 56px;
      padding: 0 8px;
    }
    .site-header .wordmark {
      padding: 0 8px 0 12px;
      font-size: 17.3px;
    }
    .site-header__links {
      gap: 4px;
    }
    .site-header__nav a {
      height: 36px;
      padding-inline: 12px;
      font-size: 14px;
    }
    .site-header__pill .site-header__cta {
      min-height: 40px;
    }
  }

  .site-footer {
    margin-top: var(--space-3xl);
    padding-bottom: var(--space-md);
  }
  .site-footer__panel {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links li,
  .site-footer__links a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
  }
  .site-footer__small {
    color: #b5aea6;
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    .site-footer__panel {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-xl);
      padding: var(--space-2xl) var(--space-2xl) var(--space-xl);
    }
    .site-footer__links {
      grid-row: 1 / span 2;
      grid-column: 2;
      flex-direction: row;
      gap: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__pill,
    .wordmark,
    .wordmark__arc,
    .wordmark__text,
    .site-header__nav,
    .site-header__nav a,
    .site-header__cta,
    .site-footer__links a {
      transition: none !important;
    }
  }
</style>
