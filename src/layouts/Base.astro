---
import "../styles/global.css";
import buildInfo from "../generated/build-info.json";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The sticky "Book a call" button. Off on /thanks, where the visitor is already booking. */
  cta?: boolean;
}

const { title = "Arcbuildr", description, noindex = false, cta = true } = Astro.props;

// Preview-only build line. Unknown branch counts as main, so it stays hidden.
const showBuild = !["main", "unknown", ""].includes(buildInfo.branch);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="wordmark" href="/">
          Arcbuildr
        </a>
        {cta && (
          <a class="btn" href="/#start">
            Book a call
          </a>
        )}
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="site-footer__line">Arcbuildr. Personal brand service.</p>
        <ul class="site-footer__links">
          <li>Instagram @arcbuildr</li>
          <li>TikTok @arcbuildr</li>
          <li>[email]</li>
          <li>
            <a href="/privacy">Privacy</a>
          </li>
        </ul>
        <p class="site-footer__small">© 2026 Arcbuildr</p>
        {showBuild && (
          <p class="site-footer__small" data-build>
            Preview build: {buildInfo.branch} ({buildInfo.branchSource}) {buildInfo.commit}
          </p>
        )}
      </div>
    </footer>
  </body>
</html>

<script>
  // Dead code on main: the define in astro.config.mjs makes this false and Vite drops the import.
  if (__PREVIEW__) import("../components/mountFeedback");
</script>

<style is:global>
  main {
    flex: 1;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-paper);
    border-bottom: var(--rule-thin);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 3.5rem;
    padding-block: var(--space-xs);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .site-footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-xl);
    border-top: var(--rule-thin);
    background: var(--color-paper-2);
  }
  .site-footer__line {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: var(--space-md) 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .site-footer__links li {
    display: flex;
    align-items: center;
    min-height: var(--tap);
  }
  .site-footer__small {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    .site-footer .wrap {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-xl);
    }
    .site-footer__links {
      grid-row: 1 / span 2;
      grid-column: 2;
      flex-direction: row;
      gap: var(--space-lg);
      margin: 0;
    }
  }
</style>
