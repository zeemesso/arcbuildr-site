---
/**
 * The home page's own layout. It shares the head with Base.astro and loads only tokens.css and the
 * page styles (src/styles/page/): its class names would collide with the other pages' styles.
 */
import "../styles/tokens.css";
import "../styles/page/frame.css";
import "../styles/page/sections.css";
import "../styles/page/more.css";
import "../styles/page/screens.css";
import "../styles/page/folio.css";
import "../styles/page/tight.css";
import Head from "./Head.astro";
import { meta } from "../content/site";
import { section } from "../content/deck";
interface Props {
  /** The home page takes its title and description from the deck; another page gives its own. */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** True for a page that starts the form itself, with its own settings. */
  ownForm?: boolean;
}
const head = section("title and description");
const {
  title = head.get("title"),
  description = head.get("description"),
  noindex = false,
  ownForm = false,
} = Astro.props;
// A shared link shows the deck's own preview lines.
const share = Astro.props.title
  ? undefined
  : { title: head.get("link preview, title"), description: head.get("link preview, description") };
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en" class="home" data-own-form={ownForm ? "" : undefined}>
  <head>
    <Head title={title} description={description} noindex={noindex} share={share} />
  </head>
  <body>
    <a class="skip" href="#main">
      {meta.skip}
    </a>
    <slot name="bar" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="after" />
    <!-- The page's own script comes before the visit counter: scripts run in this order, so another
         company's slow server can never hold the page's script up. -->
    <script>
      // Preview builds only: `?vsl=demo` shows the page with a test film in the video block.
      if (__PREVIEW__ && new URLSearchParams(location.search).get("vsl") === "demo")
        location.replace("/demo/vsl/");
      import "../scripts/page";
      if (__PREVIEW__) import("../components/mountFeedback");
    </script>
    {analyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
