---
/**
 * The home page's own layout. It shares the head with Base.astro and loads only tokens.css and the
 * page styles (src/styles/page/): its class names would collide with the other pages' styles.
 */
import "../styles/tokens.css";
import "../styles/page/frame.css";
import "../styles/page/cards.css";
import Head from "./Head.astro";
import { meta } from "../content/site";
import { section } from "../content/deck";
const head = section(15);
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en" class="home">
  <head>
    <Head title={head.get("title")} description={head.get("description")} />
  </head>
  <body>
    <a class="skip" href="#main">
      {meta.skip}
    </a>
    <slot name="bar" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="after" />
    {analyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </body>
</html>
<script>
  import "../scripts/page";
  if (__PREVIEW__) import("../components/mountFeedback");
</script>
