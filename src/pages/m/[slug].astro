---
import type { GetStaticPaths } from "astro";
import MagnetForm from "../../components/MagnetForm.astro";
import Base from "../../layouts/Base.astro";
import { FORM_TEXT } from "../../lib/magnet/text";
import { visibleMagnets } from "../../magnets/registry";
import type { MagnetDefinition } from "../../magnets/types";

export const getStaticPaths = (() =>
  visibleMagnets(__PREVIEW__).map((magnet) => ({
    params: { slug: magnet.slug },
    props: { magnet },
  }))) satisfies GetStaticPaths;

interface Props {
  magnet: MagnetDefinition;
}

const { magnet } = Astro.props;
const { heroVideo, meta } = magnet;
const draft = magnet.status === "draft";
---

<Base title={meta.title} description={meta.description} noindex={draft} cta={false}>
  <div class="wrap magnet">
    <header class="magnet__intro">
      {draft && <p class="magnet__draft">{FORM_TEXT.draft}</p>}
      <h1>{magnet.title}</h1>
      <p class="magnet__audience">{magnet.forWho}</p>
      <p>{magnet.intro}</p>
      <p class="magnet__minutes">{FORM_TEXT.minutes(magnet.minutes)}</p>
    </header>
    {heroVideo && (
      <figure class="magnet__video">
        <video
          src={heroVideo.src}
          poster={heroVideo.poster}
          controls
          playsinline
          preload="metadata"
          aria-describedby={heroVideo.caption ? "magnet-video-caption" : undefined}
        />
        {heroVideo.caption && (
          <figcaption id="magnet-video-caption">{heroVideo.caption}</figcaption>
        )}
      </figure>
    )}
    <MagnetForm magnet={magnet} />
  </div>
</Base>

<style>
  .magnet {
    display: grid;
    gap: var(--space-xl);
    max-width: calc(var(--measure) + var(--gutter) * 2);
    padding-top: var(--space-2xl);
  }
  .magnet__intro {
    display: grid;
    gap: var(--space-md);
    justify-items: center;
    text-align: center;
  }
  .magnet__draft,
  .magnet__minutes,
  figcaption {
    font-size: var(--text-sm);
  }
  .magnet__draft,
  .magnet__audience {
    font-weight: 600;
  }
  .magnet__draft {
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
  }
  .magnet__minutes,
  figcaption {
    color: var(--color-ink-muted);
  }
  .magnet__video {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
  }
  video {
    display: block;
    width: 100%;
    border-radius: var(--radius-md);
    background: var(--color-ink);
  }
</style>
