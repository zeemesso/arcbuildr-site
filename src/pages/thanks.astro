---
import Base from "../layouts/Base.astro";
import CalEmbed from "../components/CalEmbed.astro";
---

<Base title="Pick a time | Arcbuildr" noindex cta={false}>
  <section class="wrap thanks" aria-labelledby="thanks-title">
    <h1 id="thanks-title">Thanks. We've got your details.</h1>
    <p>Pick a time for your call below. We'll look at your profile before we talk.</p>
    <div class="cal"><CalEmbed /></div>
    <p class="fallback">
      If no time works, email us at [email] or send a DM to @arcbuildr on Instagram.
    </p>
  </section>
</Base>


<style>
  .thanks {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl) var(--space-2xl);
    justify-items: start;
  }
  .cal {
    width: 100%;
    max-width: 47.5rem;
  }
  .fallback {
    color: var(--color-ink-muted);
  }
  @media (min-width: 64rem) {
    .thanks {
      padding-block: var(--space-2xl) var(--space-3xl);
    }
    .thanks > .cal {
      margin-inline: 0;
    }
  }
</style>
