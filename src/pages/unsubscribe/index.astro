---
import "../../styles/global.css";
import { UNSUBSCRIBE_TEXT as t } from "../../lib/magnet/text";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{t.title}</title>
  </head>
  <body>
    <main class="wrap stop">
      <h1>{t.title}</h1>
      <p id="stop-status" role="status">
        {t.body}
      </p>
      <button class="btn" id="stop-button" type="button">
        {t.button}
      </button>
    </main>
  </body>
</html>

<script>
  import { TOKEN, unsubscribeApiPath } from "../../lib/magnet/contract";
  import { UNSUBSCRIBE_TEXT } from "../../lib/magnet/text";

  // The code rides in the fragment, like the result link. Nothing happens until the click:
  // mail scanners open links, and a scanner must not unsubscribe anyone.
  const status = document.getElementById("stop-status")!;
  const button = document.getElementById("stop-button") as HTMLButtonElement;
  const code = location.hash.slice(1);

  if (!TOKEN.test(code)) {
    status.textContent = UNSUBSCRIBE_TEXT.badLink;
    button.hidden = true;
  }

  button.addEventListener("click", async () => {
    button.disabled = true;
    button.textContent = UNSUBSCRIBE_TEXT.working;
    try {
      const response = await fetch(unsubscribeApiPath(code), {
        method: "POST",
        headers: { Accept: "application/json" },
      });
      const result = (await response.json()) as { ok?: boolean };
      if (!response.ok || result.ok !== true) throw new Error("not stopped");
      status.textContent = UNSUBSCRIBE_TEXT.done;
      button.hidden = true;
    } catch {
      status.textContent = UNSUBSCRIBE_TEXT.failure;
      button.disabled = false;
      button.textContent = UNSUBSCRIBE_TEXT.button;
    }
  });
</script>

<style>
  .stop {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    max-width: calc(var(--measure) + var(--gutter) * 2);
    padding-block: var(--space-2xl);
  }
  #stop-status {
    color: var(--color-ink-muted);
  }
  button[hidden] {
    display: none;
  }
</style>
