---
import Base from "../layouts/Base.astro";
import { notFound } from "../content/site";
---

<Base title={notFound.title} noindex>
  <section class="prose">
    <h1>{notFound.h1}</h1>
    <p class="prose__lead">{notFound.body}</p>
    <a class="prose__link" href="/">
      {notFound.link}
    </a>
  </section>
</Base>
