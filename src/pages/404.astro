---
import Base from "../layouts/Base.astro";
import { notFound } from "../content/site";
---

<Base title={notFound.title} noindex>
  <section class="wrap legal flow">
    <h1>{notFound.h1}</h1>
    <p>{notFound.body}</p>
    <p>
      <a class="text-link" href="/">
        {notFound.link}
      </a>
    </p>
  </section>
</Base>
