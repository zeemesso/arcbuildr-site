---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";

const steps = [
  {
    hue: "strategy",
    art: "target",
    name: "Brand Strategy",
    text: "We start with your story and your expertise. Together we decide who you speak to, what you want to be known for, and what you have to say about it.",
  },
  {
    hue: "identity",
    art: "swatches",
    name: "Visual Identity System",
    text: "Your colors, type and templates for posts and stories, so everything you publish looks like it comes from the same person.",
  },
  {
    hue: "profile",
    art: "grid",
    name: "Profile Audit & Optimization",
    text: "We go through your Instagram profile as it is today and fix what gets in the way: your name field, bio, link and pinned posts.",
  },
  {
    hue: "content",
    art: "stack",
    name: "Content Strategy & Production",
    text: "A content plan, a story sequence system, suggested highlights, carousels and short-form pieces. We choose the format for each piece based on what it has to say.",
  },
  {
    hue: "support",
    art: "chat",
    name: "Ongoing Support",
    text: "We stay with you after we deliver. When you have a question, you get an answer. When something needs to change, we revise it.",
  },
];

const faq = [
  {
    q: "How much does it cost?",
    a: "It depends on how much content you need. We'll give you a price after the call, once we know what you need.",
  },
  {
    q: "Do you post for me?",
    a: "No. We hand you everything ready to post, and you publish it on your account.",
  },
  {
    q: "Do you edit videos?",
    a: "For some clients, yes. It depends on you and the content. We'll tell you on the call.",
  },
  {
    q: "Which platforms do you work on?",
    a: "Instagram first. TikTok for some clients, when it fits who you are and who you want to reach. We don't work on LinkedIn or YouTube.",
  },
  {
    q: "Do you work with my industry?",
    a: "We work with business-driven people in any field. The work starts from you, whatever your industry.",
  },
  {
    q: "What do I need to give you?",
    a: "Time for a few conversations about your story and your work, and your current profile. You don't need anything ready before the call.",
  },
  {
    q: "Can you guarantee followers or sales?",
    a: "No. We agree on the work up front, deliver it, and stay with you after. Followers and sales also depend on how often you post and what you do with the content.",
  },
  {
    q: "How long does it take?",
    a: "It depends on how much content we're making. You'll get a timeline on the call.",
  },
];
---

<Base
  title="Arcbuildr | Personal brand service for business-driven people"
  description="We build your personal brand and Instagram content from your real story and expertise. Brand strategy, visual identity, profile audit, content and ongoing support."
>
  <section class="hero wrap" id="top" aria-labelledby="hero-title">
    <h1 id="hero-title">
      We build your personal brand from your <span class="serif">real story.</span>
    </h1>
    <p class="lede">
      Arcbuildr is a personal brand service for business-driven people. We take your story and what
      you know, and build the brand and content that show it on Instagram, and on TikTok when it
      fits you.
    </p>
    <div class="hero__action">
      <a class="btn btn--lg" href="#start">
        Book an intro call
      </a>
      <p class="note">Free, 30 minutes. We'll tell you on the call if we're a fit.</p>
    </div>

    <div class="profile" aria-hidden="true">
      <div class="profile__card profile__card--before">
        <div class="profile__head">
          <span class="profile__avatar"></span>
          <span class="bars">
            <i></i>
            <i></i>
          </span>
        </div>
        <div class="profile__tiles">
          {Array.from({ length: 6 }, () => (
            <span></span>
          ))}
        </div>
      </div>
      <div class="profile__card profile__card--after">
        <div class="profile__head">
          <span class="profile__avatar"></span>
          <span class="profile__stats">
            <i></i>
            <i></i>
            <i></i>
          </span>
        </div>
        <span class="bars">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <div class="profile__highlights">
          {steps.map((s) => (
            <span style={`--hue: var(--hue-${s.hue})`}></span>
          ))}
        </div>
        <div class="profile__tiles">
          {Array.from({ length: 9 }, (_, i) => (
            <span style={`--hue: var(--hue-${steps[i % 5].hue})`}></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="statement wrap reveal" id="for" aria-labelledby="for-title">
    <h2 id="for-title">
      For people who <span class="serif">build businesses</span>
    </h2>
    <div class="statement__body">
      <p>
        You run a business, or you're building one. You know your field well. Your Instagram shows a
        small part of that, or none of it, because your time goes into the work.
      </p>
      <p>
        We don't split clients by industry. Each brand starts from the person behind it, so two
        clients in the same field end up with different brands.
      </p>
    </div>
  </section>

  <section class="section wrap" id="build" aria-labelledby="build-title">
    <h2 id="build-title" class="section__title">
      What we build, <span class="serif">in the order we build it</span>
    </h2>
    <ol class="bento">
      {steps.map((s) => (
        <li class="card bento__card reveal" style={`--hue: var(--hue-${s.hue})`}>
          <div class="bento__text">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </div>
          <div class={`art art--${s.art}`} aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap" id="roles" aria-labelledby="roles-title">
    <h2 id="roles-title" class="section__title">
      Who does <span class="serif">what</span>
    </h2>
    <div class="roles">
      <p class="card roles__card roles__card--us reveal">
        We build the strategy, the identity and the content, and hand it to you ready to post.
      </p>
      <p class="card roles__card reveal">
        You publish it on your own account. We don't post for you. Your account stays yours, and the
        conversations with your audience stay with you.
      </p>
      <p class="roles__video">
        For some clients we also edit their videos. We'll tell you on the call whether that makes
        sense for you.
      </p>
    </div>
  </section>

  <section class="section wrap" id="us" aria-labelledby="us-title">
    <div class="card note-card reveal">
      <div class="polaroids">
        <div class="polaroid polaroid--back" aria-hidden="true"></div>
        <div class="polaroid photo" role="img" aria-label="Photo of Zyade and Hanane, to come">
          <span>[Photo of you both.]</span>
        </div>
      </div>
      <h2 id="us-title">
        Who <span class="serif">we are</span>
      </h2>
      <div class="prose">
        <p>
          Arcbuildr is Zyade and Hanane. We started it on September 23, 2026, and you work with the
          two of us directly.
        </p>
        <p>
          We're new. That's why this page lays out every step of how we work. On the call, we open
          your profile together and show you what we'd build for it.
        </p>
        <p class="todo">[Zyade: one line on who you are and what you do in Arcbuildr.]</p>
        <p class="todo">[Hanane: one line on who she is and what she does in Arcbuildr.]</p>
      </div>
    </div>
  </section>

  <section class="section wrap" id="questions" aria-labelledby="questions-title">
    <h2 id="questions-title" class="section__title">
      Questions
    </h2>
    <div class="card faq">
      {faq.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section wrap" id="start" aria-labelledby="start-title">
    <div class="card start">
      <div class="start__intro">
        <h2 id="start-title">
          Start <span class="serif">with a call</span>
        </h2>
        <p>Tell us about you and your business. On the next screen, you pick a time.</p>
      </div>
      <LeadForm />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-xl) 0;
    text-align: center;
  }
  .hero h1 {
    max-width: 14ch;
  }
  .lede {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 34rem;
  }
  .hero__action {
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
  }
  .note {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* Hero visual: a scattered profile behind, the built one in front. */
  .profile {
    position: relative;
    width: min(100%, 26rem);
    height: 24rem;
    margin-top: var(--space-xl);
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
  .profile__card {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: var(--rule-thin);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-lift);
  }
  .profile__card--before {
    width: 78%;
    left: -4%;
    top: 2.5rem;
    rotate: -7deg;
    opacity: 0.55;
    box-shadow: var(--shadow-card);
  }
  .profile__card--after {
    width: 84%;
    left: 14%;
    rotate: 3deg;
  }
  .profile__head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .profile__avatar {
    flex: none;
    width: 3.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-paper-2);
  }
  .profile__card--after .profile__avatar {
    border: 3px solid var(--color-card);
    outline: 2.5px solid var(--color-accent);
    background: linear-gradient(135deg, var(--hue-identity), var(--color-accent));
  }
  .profile__stats {
    flex: 1;
    display: flex;
    justify-content: space-around;
  }
  .profile__stats i {
    width: 2rem;
    height: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
  }
  .bars {
    display: grid;
    gap: 0.4rem;
    flex: 1;
  }
  .bars i {
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
  }
  .bars i:first-child {
    width: 45%;
    background: var(--color-ink);
  }
  .bars i:nth-child(2) {
    width: 85%;
  }
  .bars i:nth-child(3) {
    width: 65%;
  }
  .profile__highlights {
    display: flex;
    justify-content: space-between;
  }
  .profile__highlights span {
    width: 2.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid var(--color-card);
    outline: 2px solid var(--hue);
    background: color-mix(in oklab, var(--hue) 18%, var(--color-card));
  }
  .profile__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }
  .profile__tiles span {
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    background: var(--color-paper-2);
  }
  .profile__card--after .profile__tiles span {
    background:
      linear-gradient(160deg, transparent 55%, oklch(100% 0 0 / 0.35)),
      color-mix(in oklab, var(--hue) 70%, var(--color-card));
  }
  .profile__card--after .profile__tiles span:nth-child(3n + 2) {
    background: color-mix(in oklab, var(--hue) 16%, var(--color-card));
  }

  /* Statement */
  .statement {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .statement h2 {
    max-width: 16ch;
  }
  .statement__body {
    display: grid;
    gap: var(--space-md);
    max-width: 36rem;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  /* Shared section frame */
  .section {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) 0;
  }
  .section__title {
    max-width: 18ch;
    justify-self: center;
    text-align: center;
  }
  .section__title .serif,
  .statement h2 .serif {
    display: block;
  }

  /* Bento of the five deliverables */
  .bento {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .bento__card {
    counter-increment: step;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg);
    overflow: hidden;
  }
  .bento__text {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }
  .bento__text::before {
    content: counter(step, decimal-leading-zero);
    justify-self: start;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--hue) 12%, var(--color-card));
    color: var(--hue);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .bento__text p {
    color: var(--color-ink-muted);
  }

  /* Bleeds to 0.75rem from the card edge, so its radius stays concentric (1.75 - 0.75). */
  .art {
    position: relative;
    align-self: end;
    height: 8.5rem;
    margin: 0 calc(var(--space-sm) - var(--space-lg)) calc(var(--space-sm) - var(--space-lg));
    border-radius: calc(var(--radius-lg) - var(--space-sm));
    background: color-mix(in oklab, var(--hue) 9%, var(--color-card));
    overflow: hidden;
  }
  .art i {
    position: absolute;
    display: block;
  }
  /* Strategy: a target, the point you want to be known for. */
  .art--target i:nth-child(-n + 3) {
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border: 2px solid var(--hue);
    translate: -50% -50%;
  }
  .art--target i:nth-child(1) {
    width: 6.5rem;
    height: 6.5rem;
    opacity: 0.35;
  }
  .art--target i:nth-child(2) {
    width: 4rem;
    height: 4rem;
    opacity: 0.6;
  }
  .art--target i:nth-child(3) {
    width: 1.4rem;
    height: 1.4rem;
    background: var(--hue);
  }
  /* Identity: a palette and a type sample. */
  .art--swatches {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .art--swatches i {
    position: static;
    width: 2.25rem;
    height: 4.5rem;
    border-radius: var(--radius-pill);
    background: var(--hue);
  }
  .art--swatches i:nth-child(2) {
    background: color-mix(in oklab, var(--hue) 55%, var(--color-card));
  }
  .art--swatches i:nth-child(3) {
    background: var(--color-ink);
  }
  .art--swatches i:nth-child(4) {
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }
  .art--swatches i:nth-child(n + 5) {
    display: none;
  }
  /* Profile: a fixed grid, one tile in focus. */
  .art--grid {
    display: grid;
    grid-template-columns: repeat(3, 2.4rem);
    gap: 3px;
    place-content: center;
  }
  .art--grid i {
    position: static;
    height: 2.4rem;
    border-radius: 4px;
    background: color-mix(in oklab, var(--hue) 30%, var(--color-card));
  }
  .art--grid i:nth-child(2),
  .art--grid i:nth-child(6) {
    background: var(--hue);
  }
  /* Content: a carousel, slides fanned out. */
  .art--stack i:nth-child(-n + 3) {
    top: 1.4rem;
    left: 50%;
    width: 4.6rem;
    height: 5.75rem;
    border-radius: 0.6rem;
    box-shadow: var(--shadow-card);
  }
  .art--stack i:nth-child(1) {
    translate: -110% 0;
    rotate: -8deg;
    background: color-mix(in oklab, var(--hue) 35%, var(--color-card));
  }
  .art--stack i:nth-child(2) {
    translate: 10% 0;
    rotate: 8deg;
    background: color-mix(in oklab, var(--hue) 60%, var(--color-card));
  }
  .art--stack i:nth-child(3) {
    translate: -50% -0.5rem;
    background: var(--hue);
  }
  /* Support: a question and an answer. */
  .art--chat i:nth-child(-n + 2) {
    height: 2rem;
    border-radius: 1rem;
  }
  .art--chat i:nth-child(1) {
    left: 1.25rem;
    top: 1.75rem;
    width: 55%;
    border-bottom-left-radius: 0.3rem;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .art--chat i:nth-child(2) {
    right: 1.25rem;
    bottom: 1.75rem;
    width: 45%;
    border-bottom-right-radius: 0.3rem;
    background: var(--hue);
  }
  .art--target i:nth-child(n + 4),
  .art--stack i:nth-child(n + 4),
  .art--chat i:nth-child(n + 3) {
    display: none;
  }

  /* Who does what */
  .roles {
    display: grid;
    gap: var(--space-sm);
  }
  .roles__card {
    max-width: none;
    padding: var(--space-xl) var(--space-lg);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .roles__card--us {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .roles__video {
    justify-self: center;
    text-align: center;
    color: var(--color-ink-muted);
    padding-top: var(--space-sm);
  }

  /* Founder note */
  .note-card {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    width: 100%;
    max-width: 46rem;
    justify-self: center;
    padding: var(--space-xl) var(--space-lg);
  }
  .prose {
    display: grid;
    gap: var(--space-md);
  }
  .polaroids {
    position: relative;
    height: 15rem;
  }
  .polaroid {
    position: absolute;
    top: 0;
    left: 50%;
    width: 12rem;
    height: 14rem;
    padding: 0.6rem 0.6rem 2.4rem;
    background: var(--color-card);
    border-radius: 0.35rem;
    box-shadow: var(--shadow-lift);
  }
  .polaroid--back {
    translate: -80% 0.4rem;
    rotate: -9deg;
    background:
      linear-gradient(var(--color-paper-2), var(--color-paper-2)) content-box,
      var(--color-card);
  }
  .photo {
    display: grid;
    place-items: center;
    translate: -30% 0;
    rotate: 5deg;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    text-align: center;
    background:
      linear-gradient(var(--color-paper-2), var(--color-paper-2)) content-box,
      var(--color-card);
  }
  .todo {
    color: var(--color-ink-muted);
  }

  /* Questions */
  .faq {
    width: 100%;
    max-width: 46rem;
    justify-self: center;
    padding: var(--space-xs) var(--space-lg);
  }
  .faq details + details {
    border-top: var(--rule-thin);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 3.5rem;
    padding-block: var(--space-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "+" / "";
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-paper-2);
    font-size: var(--text-lg);
    line-height: 1;
    transition: rotate var(--dur-fast) var(--ease-out);
  }
  .faq details[open] summary::after {
    rotate: 45deg;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .faq details p {
    padding-bottom: var(--space-md);
    color: var(--color-ink-muted);
  }

  /* Book the call */
  .start {
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-lg);
  }
  .start__intro {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .start__intro p {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .bento__card {
      grid-column: span 3;
    }
    .bento__card:nth-child(n + 3) {
      grid-column: span 2;
    }
    .roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .roles__video {
      grid-column: 1 / -1;
    }
    .polaroids {
      position: absolute;
      top: -2.5rem;
      right: -3rem;
      width: 16rem;
      height: 14rem;
    }
    .note-card {
      padding: var(--space-2xl) 16rem var(--space-2xl) var(--space-2xl);
    }
    .start {
      padding: var(--space-2xl);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--space-3xl);
    }
    .profile {
      width: 30rem;
      height: 26rem;
    }
    .statement {
      padding-block: var(--space-3xl) var(--space-2xl);
    }
    .section {
      padding-top: var(--space-3xl);
    }
    .bento__card,
    .bento__card:nth-child(n + 3) {
      grid-column: span 2;
    }
    .bento__card:nth-child(-n + 2) {
      grid-column: span 3;
    }
    .start {
