---
import { MagneticButton } from "@/components/ui/magnetic-button";
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import DeliverableArt from "../components/DeliverableArt.astro";
import { deliverables } from "../data/deliverables";

const pains = [
  "I don't know what I should be known for.",
  "I run out of ideas after a few posts.",
  "I sit down to film and don't know what to say.",
  "My profile doesn't look like the business I run.",
];

const approach = [
  {
    name: "Real material",
    text: "Your work, your clients, your past, the way you think. The raw material is already there. We find it and sort it.",
  },
  {
    name: "Direction",
    text: "A few things you want to be known for, clear enough that people know what to expect from you, without turning you into a niche caricature.",
  },
  {
    name: "Content",
    text: "A real experience, one useful idea and a visual way to tell it. Something only you could post.",
  },
];

const fitFor = [
  "You run a business or sell what you know.",
  "You're willing to show your face and your work.",
  "Your clients are on Instagram, or that's where you want them to find you.",
  "You'll film and post on a rhythm we agree on.",
];
const fitNot = [
  "You want someone to run your account for you.",
  "You want a follower number guaranteed.",
  "You'd rather stay off camera.",
  "Your main platform is LinkedIn or YouTube.",
];

const faq = [
  {
    q: "How much does it cost?",
    a: "It depends on what you need. We share the price after the call, once we both know it's a fit.",
  },
  {
    q: "How long does it take?",
    a: "About six weeks. The plan can shift with what you need.",
  },
  {
    q: "How much of my time does it take?",
    a: "A kickoff call, a few reviews along the way, and the time you spend filming. We prepare everything else.",
  },
  {
    q: "Do you post for me or edit my videos?",
    a: "No. We write what to say and show. You film, edit and post, or your team does.",
  },
  {
    q: "Which platforms do you work on?",
    a: "Instagram first. TikTok for some clients, when it fits who you are and who you want to reach. We don't work on LinkedIn or YouTube.",
  },
  {
    q: "Do you work with my industry?",
    a: "If you run a business or sell what you know, yes. The work starts from you, whatever your field.",
  },
  {
    q: "What do I need to give you?",
    a: "Your answers to the story intake, a few conversations about your work, and your current profile. Nothing needs to be ready before the call.",
  },
  {
    q: "What if we're not a fit?",
    a: "We tell you on the call, and why. You still leave with at least one thing to fix on your profile.",
  },
  {
    q: "Can you guarantee followers or sales?",
    a: "No. We agree on the work up front, deliver it, and review it with you. Followers and sales also depend on how often you post and what you do with the content.",
  },
];
---

<Base
  title="Arcbuildr | A personal brand built from your real story"
  description="For founders and business owners on Instagram. In six weeks we build your brand strategy, visual identity, profile and content from your real story. You film and post. We tell you what to say and show."
>
  <section class="hero wrap" id="top" aria-labelledby="hero-title">
    <p class="kicker hero__kicker">For founders and business owners</p>
    <h1 id="hero-title">
      A personal brand built from your <span class="hl">real story,</span> in six weeks.
    </h1>
    <p class="lede">
      You know your work. Your Instagram doesn't show it yet. We decide with you what you should be
      known for, shape how your profile looks, and write what to say and show in every piece.
    </p>
    <div class="hero__action">
      <MagneticButton
        client:media="(hover: hover) and (pointer: fine)"
        className="btn btn--lg"
        href="#start"
      >
        Book a call
      </MagneticButton>
      <p class="note">
        Free, 30 minutes. We look at your profile together and tell you if we're a fit.
      </p>
    </div>

    <div class="profile" aria-hidden="true">
      <div class="profile__card profile__card--before">
        <div class="profile__head">
          <span class="profile__avatar"></span>
          <span class="bars">
            <i></i>
            <i></i>
          </span>
        </div>
        <div class="profile__tiles">
          {Array.from({ length: 6 }, () => (
            <span></span>
          ))}
        </div>
      </div>
      <div class="profile__card profile__card--after">
        <div class="profile__head">
          <span class="profile__avatar"></span>
          <span class="profile__stats">
            <i></i>
            <i></i>
            <i></i>
          </span>
        </div>
        <span class="bars">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <div class="profile__highlights">
          {deliverables.map((s, i) => (
            <span style={`--hue: var(--hue-${s.hue}); --i: ${i}`}></span>
          ))}
        </div>
        <div class="profile__tiles">
          {Array.from({ length: 6 }, (_, i) => (
            <span style={`--hue: var(--hue-${deliverables[i % 5].hue}); --i: ${i}`}></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="statement wrap reveal" id="for" aria-labelledby="for-title">
    <h2 id="for-title">
      You know your work. <span class="hl">Your page doesn't show it.</span>
    </h2>
    <ul class="pains">
      {pains.map((line) => (
        <li class="pains__item">“{line}”</li>
      ))}
    </ul>
    <div class="statement__body">
      <p>
        Each of these comes from a decision nobody has made yet: who you speak to, what you stand
        for, how your page should look. We make those decisions with you first, so every piece has
        somewhere to come from.
      </p>
    </div>
  </section>

  <section class="section wrap" id="approach" aria-labelledby="approach-title">
    <h2 id="approach-title" class="section__title reveal">
      We start from what <span class="hl">you've already lived</span>
    </h2>
    <ol class="approach">
      {approach.map((s, i) => (
        <li class={`card approach__card reveal${i === 1 ? " approach__card--mid" : ""}`}>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap" id="build" aria-labelledby="build-title">
    <h2 id="build-title" class="section__title reveal">
      What you get, <span class="hl">in the order we build it</span>
    </h2>
    <ol class="bento">
      {deliverables.map((s, i) => (
        <li
          class="card bento__card reveal"
          style={`--hue: var(--hue-${s.hue}); --d: ${(i < 2 ? i : i - 2) * 90}ms`}
        >
          <div class="bento__text">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </div>
          <DeliverableArt art={s.art} />
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap" id="roles" aria-labelledby="roles-title">
    <h2 id="roles-title" class="section__title reveal">
      We decide and write. <span class="hl">You film and post.</span>
    </h2>
    <div class="roles">
      <p class="card roles__card roles__card--us reveal">
        We make the decisions with you and write every piece: what to say, what to show, and how it
        should look.
      </p>
      <p class="card roles__card reveal">
        You film and post on your own account, with your team if you have one. Your account stays
        yours, and the conversations with your audience stay with you.
      </p>
      <p class="roles__video">We don't edit your videos or post for you.</p>
    </div>
  </section>

  <section class="section wrap" id="fit" aria-labelledby="fit-title">
    <h2 id="fit-title" class="section__title reveal">
      Who this <span class="hl">is for</span>
    </h2>
    <div class="fit">
      <div class="card fit__card fit__card--yes reveal">
        <h3>For you if</h3>
        <ul>
          {fitFor.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
      <div class="card fit__card reveal">
        <h3>Not for you if</h3>
        <ul>
          {fitNot.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap" id="us" aria-labelledby="us-title">
    <div class="card note-card reveal">
      <div class="polaroids">
        <div class="polaroid polaroid--back" aria-hidden="true"></div>
        <div class="polaroid photo" role="img" aria-label="Photo of Zyade, to come">
          <span>[Your photo.]</span>
        </div>
      </div>
      <h2 id="us-title">
        You work <span class="hl">directly with me</span>
      </h2>
      <div class="prose">
        <p>
          I'm Zyade. I started Arcbuildr on September 23, 2026. It isn't an agency, and you don't
          get handed off to a team. You work with me, from the first call to the last review.
        </p>
        <p>
          I take a few clients at a time, so each one gets my full attention. The thinking we do
          together on the calls is part of the work.
        </p>
        <p>
          I won't show you results I don't have. The first brand going through this system is my
          own. On the call, we open your profile together and I show you what I'd do with it.
        </p>
        <p class="todo">[Zyade: one line on what you've done before Arcbuildr.]</p>
      </div>
    </div>
  </section>

  <section class="section wrap" id="questions" aria-labelledby="questions-title">
    <h2 id="questions-title" class="section__title reveal">
      Questions
    </h2>
    <div class="card faq reveal">
      {faq.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section wrap" id="start" aria-labelledby="start-title">
    <div class="card start reveal">
      <div class="start__intro">
        <h2 id="start-title">
          Start <span class="hl">with a call</span>
        </h2>
        <p>
          Tell me about you and your business. On the next screen, you pick a time. I read every
          answer and look at your profile before we talk.
        </p>
      </div>
      <LeadForm />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-xl) 0;
    text-align: center;
  }
  .hero h1 {
    max-width: 17ch;
  }
  .hero__kicker {
    color: var(--color-ink-muted);
  }
  .lede {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 34rem;
  }
  .hero__action {
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
  }
  .note {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  /* Hero visual: a scattered profile behind, the built one in front. */
  /* Both cards share one grid cell, so the box always fits them whole: no clipping, no fade. */
  .profile {
    display: grid;
    width: min(100%, 26rem);
    margin-top: var(--space-xl);
    padding: var(--space-lg) var(--space-sm) var(--space-xl);
  }
  .profile__card {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-md);
    align-content: start;
    padding: var(--space-lg);
    border: var(--rule-thin);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-lift);
  }
  .profile__card--before {
    width: 74%;
    justify-self: start;
    align-self: start;
    margin-top: 2.5rem;
    rotate: -7deg;
    opacity: 0.55;
    box-shadow: var(--shadow-card);
  }
  .profile__card--after {
    width: 80%;
    justify-self: end;
    rotate: 3deg;
  }
  .profile__head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .profile__avatar {
    flex: none;
    width: 3.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-paper-2);
  }
  .profile__card--after .profile__avatar {
    border: 3px solid var(--color-card);
    outline: 2.5px solid var(--color-accent);
    background: linear-gradient(135deg, var(--color-accent), var(--hue-content));
  }
  .profile__stats {
    flex: 1;
    display: flex;
    justify-content: space-around;
  }
  .profile__stats i {
    width: 2rem;
    height: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
  }
  .bars {
    display: grid;
    gap: 0.4rem;
    flex: 1;
  }
  .bars i {
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
  }
  .bars i:first-child {
    width: 45%;
    background: var(--color-ink);
  }
  .bars i:nth-child(2) {
    width: 85%;
  }
  .bars i:nth-child(3) {
    width: 65%;
  }
  .profile__highlights {
    display: flex;
    justify-content: space-between;
  }
  .profile__highlights span {
    width: min(2.6rem, 16%);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid var(--color-card);
    outline: 2px solid var(--hue);
    background: color-mix(in oklab, var(--hue) 18%, var(--color-card));
  }
  .profile__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }
  .profile__tiles span {
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    background: var(--color-paper-2);
  }
  .profile__card--after .profile__tiles span {
    background:
      linear-gradient(160deg, transparent 55%, oklch(100% 0 0 / 0.35)),
      color-mix(in oklab, var(--hue) 70%, var(--color-card));
  }
  .profile__card--after .profile__tiles span:nth-child(3n + 2) {
    background: color-mix(in oklab, var(--hue) 16%, var(--color-card));
  }

  /* Statement */
  .statement {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .statement h2 {
    max-width: 16ch;
  }
  .statement__body {
    display: grid;
    gap: var(--space-md);
    max-width: 36rem;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  /* Shared section frame */
  .section {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) 0;
  }
  .section__title {
    max-width: 18ch;
    justify-self: center;
    text-align: center;
  }
  .section__title .hl,
  .statement h2 .hl {
    display: block;
  }

  /* Bento of the five deliverables */
  .bento {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .bento__card {
    counter-increment: step;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg);
    overflow: hidden;
  }
  .bento__text {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }
  .bento__text::before {
    content: counter(step, decimal-leading-zero);
    justify-self: start;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--hue) 14%, var(--color-card));
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .bento__text p {
    color: var(--color-ink-muted);
  }

  /* The problem, in the visitor's words */
  .pains {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    max-width: 40rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pains__item {
    padding: var(--space-sm) var(--space-lg);
    border: var(--rule-thin);
    border-radius: var(--radius-md);
    background: var(--color-card);
    font-weight: 600;
    text-wrap: pretty;
  }

  /* How we think: three cards */
  .approach {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .approach__card {
    counter-increment: step;
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding: var(--space-xl) var(--space-lg);
  }
  .approach__card::before {
    content: counter(step, decimal-leading-zero);
    color: var(--color-accent-text);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .approach__card p {
    color: var(--color-ink-muted);
  }
  .approach__card--mid {
    background: var(--color-sage);
    border-color: var(--color-sage);
    color: var(--color-paper);
  }
  .approach__card--mid::before,
  .approach__card--mid p {
    color: inherit;
  }

  /* Who it's for */
  .fit {
    display: grid;
    gap: var(--space-sm);
  }
  .fit__card {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    padding: var(--space-xl) var(--space-lg);
  }
  .fit__card ul {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fit__card li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--space-xs);
  }
  .fit__card li::before {
    content: "\2715" / "";
    color: var(--color-ink-muted);
    font-weight: 700;
  }
  .fit__card--yes {
    background: var(--color-sage);
    border-color: var(--color-sage);
    color: var(--color-paper);
  }
  .fit__card--yes li::before {
    content: "\2713" / "";
    color: inherit;
  }

  /* Who does what */
  .roles {
    display: grid;
    gap: var(--space-sm);
  }
  .roles__card {
    max-width: none;
    padding: var(--space-xl) var(--space-lg);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .roles__card--us {
    background: var(--color-sage);
    border-color: var(--color-sage);
    color: var(--color-paper);
  }
  .roles__video {
    justify-self: center;
    text-align: center;
    color: var(--color-ink-muted);
    padding-top: var(--space-sm);
  }

  /* Founder note */
  .note-card {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    width: 100%;
    max-width: 46rem;
    justify-self: center;
    padding: var(--space-xl) var(--space-lg);
  }
  .prose {
    display: grid;
    gap: var(--space-md);
  }
  .polaroids {
    position: relative;
    height: 15rem;
  }
  .polaroid {
    position: absolute;
    top: 0;
    left: 50%;
    width: 12rem;
    height: 14rem;
    padding: 0.6rem 0.6rem 2.4rem;
    background: var(--color-card);
    border-radius: 0.35rem;
    box-shadow: var(--shadow-lift);
  }
  .polaroid--back {
    translate: -80% 0.4rem;
    rotate: -9deg;
    background:
      linear-gradient(var(--color-paper-2), var(--color-paper-2)) content-box,
      var(--color-card);
  }
  .photo {
    display: grid;
    place-items: center;
    translate: -30% 0;
    rotate: 5deg;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    text-align: center;
    background:
      linear-gradient(var(--color-paper-2), var(--color-paper-2)) content-box,
      var(--color-card);
  }
  .todo {
    color: var(--color-ink-muted);
  }

  /* Questions */
  .faq {
    width: 100%;
    max-width: 46rem;
    justify-self: center;
    padding: var(--space-xs) var(--space-lg);
  }
  .faq details + details {
    border-top: var(--rule-thin);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 3.5rem;
    padding-block: var(--space-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "+" / "";
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-paper-2);
    font-size: var(--text-lg);
    line-height: 1;
    transition: rotate var(--dur-fast) var(--ease-out);
  }
  .faq details[open] summary::after {
    rotate: 45deg;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .faq details p {
    padding-bottom: var(--space-md);
    color: var(--color-ink-muted);
  }

  /* Book the call */
  .start {
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-lg);
  }
  .start__intro {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .start__intro p {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  @media (min-width: 48rem) {
    .pains {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .approach,
    .fit {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .bento__card {
      grid-column: span 3;
    }
    .bento__card:nth-child(n + 3) {
      grid-column: span 2;
    }
    .roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .roles__video {
      grid-column: 1 / -1;
    }
    .polaroids {
      position: absolute;
      top: -2.5rem;
      right: -3rem;
      width: 16rem;
      height: 14rem;
    }
    .note-card {
      padding: var(--space-2xl) 16rem var(--space-2xl) var(--space-2xl);
    }
    .start {
      padding: var(--space-2xl);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--space-3xl);
    }
    .profile {
      width: 30rem;
    }
    .statement {
      padding-block: var(--space-3xl) var(--space-2xl);
    }
    .section {
      padding-top: var(--space-3xl);
    }
    .bento__card,
    .bento__card:nth-child(n + 3) {
      grid-column: span 2;
    }
    .bento__card:nth-child(-n + 2) {
      grid-column: span 3;
    }
    .start {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-2xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
