  }
</style>

<style>
  /* Motion. Text moves by clip and translate only; it never sits half transparent on screen. */
  @media (prefers-reduced-motion: no-preference) {
    .hero {
      --t0: 0s;
    }
    :global(.intro) .hero {
      --t0: 1.45s;
    }

    /* Hero entrance */
    .hero h1 {
      animation: wipe-up 0.9s var(--ease-out) var(--t0) backwards;
    }
    .lede {
      animation: wipe-up 0.9s var(--ease-out) calc(var(--t0) + 0.12s) backwards;
    }
    .hero__action .btn {
      animation: pop 0.7s var(--spring) calc(var(--t0) + 0.3s) backwards;
    }
    .note {
      animation: rise 0.7s var(--ease-out) calc(var(--t0) + 0.4s) backwards;
    }
    .profile__card--before {
      animation:
        fly-before 1s var(--spring) calc(var(--t0) + 0.45s) backwards,
        float 6s ease-in-out calc(var(--t0) + 1.5s) infinite alternate;
    }
    .profile__card--after {
      animation: fly-after 1.1s var(--spring) calc(var(--t0) + 0.55s) backwards;
    }

    /* The profile keeps building: story ring spins, highlights pop, tiles fill, a shine passes. */
    .profile__card--after .profile__avatar {
      position: relative;
      outline: 0;
    }
    .profile__card--after .profile__avatar::before {
      content: "";
      position: absolute;
      inset: -7px;
      border-radius: 50%;
      background: conic-gradient(
        var(--color-accent),
        var(--hue-content),
        var(--color-sage),
        var(--color-accent)
      );
      mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
      animation: spin 4s linear infinite;
    }
    .profile__highlights span {
      animation: pop 0.6s var(--spring) calc(var(--t0) + 1s + var(--i) * 80ms) backwards;
    }
    .profile__card--after .profile__tiles span {
      animation: tile-in 0.6s var(--spring) calc(var(--t0) + 1.2s + var(--i) * 90ms) backwards;
    }
    .profile__card--after .profile__tiles {
      position: relative;
      overflow: clip;
      border-radius: 4px;
    }
    .profile__card--after .profile__tiles::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        105deg,
        transparent 35%,
        rgb(255 255 255 / 0.45) 50%,
        transparent 65%
      );
      translate: -100% 0;
      animation: shine 5s var(--ease-in-out) calc(var(--t0) + 2.4s) infinite;
    }

    /* Bento cards lift; each drawing moves in its own way once its card is in view. */
    .bento__card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
    /* Polaroids drop and settle when the note arrives. */
    .polaroid {
      transition:
        transform 0.9s var(--spring),
        opacity 0.5s var(--ease-out);
    }
    .polaroid--back {
      transition-delay: 0.15s;
    }
    .photo {
      transition-delay: 0.3s;
    }
    :global(.js) .note-card:not(:global(.is-in)) .polaroid {
      opacity: 0;
      transform: translateY(-3rem) rotate(-10deg);
    }
    :global(.is-instant) .polaroid {
      transition: none;
    }
    .polaroids:hover .photo {
      transform: rotate(-4deg) scale(1.03);
      transition-delay: 0s;
    }

    /* FAQ answers open smoothly where the browser can animate to auto. */
    .faq details::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.35s var(--ease-out),
        content-visibility 0.35s allow-discrete;
    }
    .faq details[open]::details-content {
      block-size: auto;
    }
  }

  @supports (interpolate-size: allow-keywords) {
    :global(:root) {
      interpolate-size: allow-keywords;
    }
  }

  @keyframes wipe-up {
    from {
      clip-path: inset(0 0 100% 0);
      translate: 0 0.35em;
    }
    to {
      clip-path: inset(0 0 -20% 0);
      translate: 0 0;
    }
  }
  @keyframes rise {
    from {
      translate: 0 0.75rem;
    }
  }
  @keyframes pop {
    from {
      scale: 0;
    }
  }
  @keyframes tile-in {
    from {
      scale: 0.4;
      opacity: 0;
    }
  }
  @keyframes fly-before {
    from {
      opacity: 0;
      translate: -40% 15%;
      rotate: -22deg;
    }
  }
  @keyframes fly-after {
    from {
      opacity: 0;
      translate: 25% 35%;
      rotate: 16deg;
    }
  }
  @keyframes float {
    to {
      transform: translateY(-10px) rotate(-1.5deg);
    }
  }
  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
  @keyframes shine {
    0%,
    100% {
      translate: -100% 0;
    }
    35%,
    99% {
      translate: 100% 0;
    }
  }
</style>
