---
import Home from "../layouts/Home.astro";
import Bar from "../components/page/Bar.astro";
import First from "../components/page/First.astro";
import Wins from "../components/page/Wins.astro";
import Manifesto from "../components/page/Manifesto.astro";
import Founder from "../components/page/Founder.astro";
import How from "../components/page/How.astro";
import Get from "../components/page/Get.astro";
import Gallery from "../components/page/Gallery.astro";
import Berg from "../components/page/Berg.astro";
import Price from "../components/page/Price.astro";
import Guarantee from "../components/page/Guarantee.astro";
import Fit from "../components/page/Fit.astro";
import Faq from "../components/page/Faq.astro";
import Apply from "../components/page/Apply.astro";
import Foot from "../components/page/Foot.astro";
import Application from "../components/application/Application.astro";
import { section } from "../content/deck";
// The header's links are the sections' own labels.
const links = [
  { text: section(4).get("label"), href: "#how" },
  { text: section(5).get("label"), href: "#get" },
  { text: section(8).get("label"), href: "#price" },
  { text: section(11).get("label"), href: "#questions" },
];
---

<Home>
  <Bar slot="bar" links={links} />
  <First />
  <Wins />
  <Manifesto />
  <Founder />
  <How />
  <Get />
  <Gallery />
  <Berg />
  <Price />
  <Guarantee />
  <Fit />
  <Faq />
  <Apply />
  <Foot slot="after" />
  <Application slot="after" />
</Home>
