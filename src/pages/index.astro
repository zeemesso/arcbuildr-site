---
import Home from "../layouts/Home.astro";
import Bar from "../components/page/Bar.astro";
import First from "../components/page/First.astro";
import Get from "../components/page/Get.astro";
import Foot from "../components/page/Foot.astro";
import Application from "../components/application/Application.astro";
import { section } from "../content/deck";
const links = [{ text: section(5).get("label"), href: "#get" }];
---

<Home>
  <Bar slot="bar" links={links} />
  <First />
  <Get />
  <Foot slot="after" />
  <Application slot="after" />
</Home>
