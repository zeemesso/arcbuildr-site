---
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import VideoCard from "../components/VideoCard.astro";
import Mark from "../components/Mark.astro";
import Application from "../components/application/Application.astro";
import { booked } from "../content/site";
import { APPLICATION_AFTER_BOOKING_URL, APPLICATION_MODE, CONFIRMATION_VIDEO } from "../config";

// The slot takes the confirmation video. Until its file is in public/, the card shows the poster.
const video =
  CONFIRMATION_VIDEO && existsSync(new URL(`../../public${CONFIRMATION_VIDEO}`, import.meta.url))
    ? CONFIRMATION_VIDEO
    : "";
const native = APPLICATION_MODE === "native";
const words = booked.application;
---

<Base title={booked.title} description={booked.description} noindex apply={false}>
  <article class="doc">
    <h1 data-booked={booked.h1Named}>{booked.h1}</h1>
    <div class="doc__block">
      <p class="lead">{booked.invite}</p>
      <p>{booked.calendar}</p>
      <p data-chat-line hidden>
        {booked.chat}
      </p>
    </div>
    <VideoCard
      src={video}
      alt={booked.video.alt}
      title={booked.video.title}
      length={booked.video.length}
      play={booked.video.play}
    />
    <section class="card card--sage" aria-labelledby="booked-call">
      <h2 id="booked-call">{booked.call.title}</h2>
      <p class="small">{booked.call.meta}</p>
      <ol class="steplist">
        {booked.call.items.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </section>
    <section class="card" aria-labelledby="booked-ready">
      <h2 id="booked-ready">{booked.ready.title}</h2>
      <ul class="ticklist">
        {booked.ready.items.map((item) => (
          <li>
            <Mark />
            {item}
          </li>
        ))}
      </ul>
      <p class="muted" data-note>
        {words.body}
      </p>
      <div class="doc__block" data-chat hidden>
        <p data-chat-first>{words.first}</p>
        {native ? (
          <button class="btn btn--parts" type="button" data-apply-open data-chat-action>
            <span>{words.link[0]}</span> <span>{words.link[1]}</span>
          </button>
        ) : (
          <a class="btn btn--parts" href={APPLICATION_AFTER_BOOKING_URL} data-chat-action>
            <span>{words.link[0]}</span> <span>{words.link[1]}</span>
          </a>
        )}
        <p class="lead" data-chat-saved role="status" hidden>
          {words.saved}
        </p>
      </div>
      {/* Answers typed before the booking that had not saved are sent once more from here. */}
      <div class="doc__block" data-resend hidden>
        <p role="status" data-resend-note data-saved={words.resent} data-failed={words.unsent}></p>
        <button class="btn btn--small" type="button" data-resend-retry hidden>
          {words.retry}
        </button>
      </div>
    </section>
    <section class="doc__block" aria-labelledby="booked-before">
      <h2 id="booked-before">{booked.before.title}</h2>
      <ul class="doc__block">
        {booked.before.items.map((item) => (
          <li>
            <a class="more" href={item.href}>
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <p class="muted">{booked.refund}</p>
  </article>
</Base>
{native && <Application kind="prep" />}
<script>
  import "../scripts/booked";
</script>
