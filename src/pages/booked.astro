---
/**
 * The page after a booking (the deck's "The booked page"): him, the confirmation video, and what happens next.
 * The calendar inside the form sends people here when a booking succeeds; the first name and the email
 * are kept on the device, or come in the address when the booking page sends them.
 */
import { existsSync } from "node:fs";
import "../styles/page/booked.css";
import Home from "../layouts/Home.astro";
import Bar from "../components/page/Bar.astro";
import Foot from "../components/page/Foot.astro";
import Video from "../components/page/Video.astro";
import Application from "../components/application/Application.astro";
import { section } from "../content/deck";
import { booked } from "../content/site";
import { APPLICATION_AFTER_BOOKING_URL, APPLICATION_MODE, CONFIRMATION_VIDEO } from "../config";

const s = section("the booked page");
// The slot takes the confirmation video. Until its file is in public/, the slot shows the poster.
const video =
  CONFIRMATION_VIDEO && existsSync(new URL(`../../public${CONFIRMATION_VIDEO}`, import.meta.url))
    ? CONFIRMATION_VIDEO
    : "";
const native = APPLICATION_MODE === "native";
const button = s.get("booked from a chat, button");
---

<Home title={s.get("heading, no name")} description={s.get("practical 1")} noindex ownForm>
  <Bar slot="bar" cta={false} />
  <section class="window done" id="top" aria-labelledby="done-h">
    <div class="done__words">
      <h1 class="done__h" id="done-h" data-booked={s.get("heading")} data-enter style="--i:0">
        {s.get("heading, no name")}
      </h1>
      <ul class="done__notes" data-enter style="--i:1">
        {s.list("practical ").map(({ words }) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.5 12.5l3.5 3.5 7.5-8" />
            </svg>
            <span>{words}</span>
          </li>
        ))}
      </ul>
    </div>
    <figure class="done__video" data-enter style="--i:2">
      <figcaption>
        <b>{s.get("video, title")}</b>
        <span>{s.get("video, length")}</span>
      </figcaption>
      <Video src={video} title={s.get("video, title")} />
    </figure>
  </section>

  <section class="next" aria-labelledby="next-h">
    <h2 class="h2" id="next-h" data-reveal>
      {s.get("next, title")}
    </h2>
    <ol class="next__list">
      <li data-reveal style="--i:0">
        <b>1</b>
        <div>
          <p data-note>{s.get("next 1")}</p>
          <div class="next__chat" data-chat hidden>
            <p data-chat-first>{s.get("booked from a chat, in place of next 1")}</p>
            {native ? (
              <button class="btn" type="button" data-apply-open data-chat-action>
                {button}
              </button>
            ) : (
              <a class="btn" href={APPLICATION_AFTER_BOOKING_URL} data-chat-action>
                {button}
              </a>
            )}
            <p class="next__saved" data-chat-saved role="status" hidden>
              {booked.saved}
            </p>
            <p class="next__small" data-chat-line>
              {s.get("booked from a chat, line")}
            </p>
          </div>
          {/* Answers typed before the booking that had not saved are sent once more from here. */}
          <div class="next__chat" data-resend hidden>
            <p
              class="next__small"
              role="status"
              data-resend-note
              data-saved={booked.resent}
              data-failed={booked.unsent}
            ></p>
            <button class="btn btn--quiet" type="button" data-resend-retry hidden>
              {booked.retry}
            </button>
          </div>
        </div>
      </li>
      <li data-reveal style="--i:1">
        <b>2</b>
        <p>{s.get("next 2")}</p>
      </li>
    </ol>
  </section>
  <Foot slot="after" />
  {native && <Application kind="prep" slot="after" />}
  <!-- Inside the page, so it comes before the visit counter (see Home.astro). -->
  <Fragment slot="after">
    <script>
      import "../scripts/booked";
    </script>
  </Fragment>
</Home>
