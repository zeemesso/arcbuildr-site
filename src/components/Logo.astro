---
import logo from "../data/logo.json";

/** The arc and wordmark are round-capped strokes drawn from brand/build.mjs.
 * On Home it is not a link: a link to the page you are on is a dead tab stop. */
const here = Astro.url.pathname.replace(/(.)\/$/, "$1");
const isHome = here === "/";
const Tag = isHome ? "span" : "a";
const last = logo.word.letters.length - 1;
---

<Tag
  class="wordmark"
  aria-label="Arcbuildr"
  role={isHome ? "img" : undefined}
  href={isHome ? undefined : "/"}
>
  <svg class="wordmark__arc" viewBox={logo.arc.viewBox} aria-hidden="true">
    <path
      d={logo.arc.d}
      fill="none"
      stroke="currentColor"
      stroke-width={logo.arc.stroke}
      stroke-linecap="round"
    ></path>
  </svg>
  <span class="wordmark__text" aria-hidden="true">
    <span>
      <svg
        class="wordmark__word"
        viewBox={logo.word.viewBox}
        aria-hidden="true"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width={logo.stroke}
      >
        {logo.word.letters.map((d, i) => (
          <path
            class={i === last ? "wordmark__r" : undefined}
            d={d}
            stroke={i === last ? "var(--color-accent)" : "currentColor"}
          />
        ))}
      </svg>
    </span>
  </span>
</Tag>
