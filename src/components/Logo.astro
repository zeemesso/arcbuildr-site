---
/** The brand arc (arcbuildr-symbol.svg) and the wordmark with the orange "r", set live in Open Runde.
 * On Home it is not a link: a link to the page you are on is a dead tab stop. */
const here = Astro.url.pathname.replace(/(.)\/$/, "$1");
const isHome = here === "/";
const Tag = isHome ? "span" : "a";
---

<Tag
  class="wordmark"
  aria-label="Arcbuildr"
  role={isHome ? "img" : undefined}
  href={isHome ? undefined : "/"}
>
  <svg class="wordmark__arc" viewBox="0 0 100 66" aria-hidden="true">
    <path
      d="M18 52 A 32 32 0 0 1 82 52"
      fill="none"
      stroke="currentColor"
      stroke-width="18"
      stroke-linecap="round"
    ></path>
  </svg>
  <span class="wordmark__text" aria-hidden="true">
    <span>
      arcbuild<span class="wordmark__r">r</span>
    </span>
  </span>
</Tag>
