---
/** The brand arc (arcbuildr-symbol.svg) and the wordmark with the orange "r", set live in Open Runde. */
---

<a class="wordmark" href="/" aria-label="Arcbuildr">
  <svg class="wordmark__arc" viewBox="0 0 100 66" aria-hidden="true">
    <path
      d="M18 52 A 32 32 0 0 1 82 52"
      fill="none"
      stroke="currentColor"
      stroke-width="18"
      stroke-linecap="round"
    ></path>
  </svg>
  <span aria-hidden="true">
    arcbuild<span class="wordmark__r">r</span>
  </span>
</a>
