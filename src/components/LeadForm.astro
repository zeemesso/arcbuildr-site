---
// The application form. Works as a plain POST without JavaScript. The script below adds
// inline checks, a sending state, one automatic retry, and a failure message that keeps
// what was typed and offers WhatsApp. Question wording: src/data/application.ts.
import { en } from "../i18n/en";
import { QUESTIONS, REQUIRED_CHOICES } from "../data/application";
import { whatsappHref } from "../config";

const t = en.form;
const q = QUESTIONS;
const wa = whatsappHref(en.thanks.whatsappText);
// The call language starts on English, one less tap for most visitors.
const preset: Record<string, string> = { language: "English" };
---

<form
  id="lead-form"
  method="post"
  action="/api/lead"
  class="form"
  data-checks={JSON.stringify(t.checks)}
  data-sending={t.sending}
  data-retrying={t.retrying}
  data-thanks="/thanks"
>
  <div class="field">
    <label for="f-name">{q.name.label}</label>
    <input id="f-name" name="name" type="text" autocomplete="name" required />
    <p class="error" id="f-name-error" hidden></p>
  </div>

  <div class="field">
    <label for="f-email">{q.email.label}</label>
    <input
      id="f-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      autocapitalize="none"
      spellcheck="false"
      required
    />
    <p class="error" id="f-email-error" hidden></p>
  </div>

  <div class="field">
    <label for="f-phone">{q.phone.label}</label>
    <input
      id="f-phone"
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      placeholder={q.phone.placeholder}
      aria-describedby="f-phone-help"
      required
    />
    <p class="help" id="f-phone-help">
      {q.phone.help}
    </p>
    <p class="error" id="f-phone-error" hidden></p>
  </div>

  <div class="field">
    <label for="f-instagram">{q.instagram.label}</label>
    <input
      id="f-instagram"
      name="instagram"
      type="text"
      placeholder={q.instagram.placeholder}
      autocomplete="off"
      autocapitalize="none"
      autocorrect="off"
      spellcheck="false"
      aria-describedby="f-instagram-help"
      required
    />
    <p class="help" id="f-instagram-help">
      {q.instagram.help}
    </p>
    <p class="error" id="f-instagram-error" hidden></p>
  </div>

  {REQUIRED_CHOICES.map((name) => {
    const question = q[name];
    const help = "help" in question ? question.help : "";
    return (
      <fieldset
        class="field choice"
        id={`f-${name}`}
        aria-describedby={help ? `f-${name}-help` : undefined}
      >
        <legend>{question.label}</legend>
        {help && (
          <p class="help" id={`f-${name}-help`}>
            {help}
          </p>
        )}
        <div class="choice__options">
          {question.options.map((option, i) => (
            <label class="chip">
              <input
                type="radio"
                name={name}
                value={option.value}
                required={i === 0}
                checked={preset[name] === option.value}
              />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
        <p class="error" id={`f-${name}-error`} hidden />
      </fieldset>
    );
  })}

  <div class="field">
    <label for="f-heard">{q.heard.label}</label>
    <select id="f-heard" name="heard">
      <option value="">-</option>
      {q.heard.options.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
  </div>

  <div class="field">
    <label for="f-referred">{q.referredBy.label}</label>
    <input id="f-referred" name="referred_by" type="text" autocomplete="off" />
  </div>

  <input type="hidden" name="tz" value="" />
  <input type="hidden" name="page" value="" />
  <input type="hidden" name="utm" value="" />
  <input type="hidden" name="sent_at" value="" />
  <div class="trap" aria-hidden="true">
    <label for="f-website">{t.trap}</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form__action">
    <button class="btn btn--block" type="submit">
      {t.submit}
    </button>
    <p class="note">
      {t.note} <a href="/privacy">{en.nav.privacy}</a>
    </p>
    <div class="error error--form" id="form-error" role="alert" hidden>
      <p>{t.error}</p>
      {wa && (
        <a class="btn btn--block" href={wa}>
          {t.errorWhatsapp}
        </a>
      )}
      <p>{t.errorDm}</p>
    </div>
    <p class="visually-hidden" id="form-status" role="status"></p>
  </div>

  <p class="dm">{t.dm}</p>
</form>

<script>
  import { normalizePhone } from "../lib/phone";
  import { REQUIRED_CHOICES as CHOICES } from "../data/application";

  const form = document.getElementById("lead-form") as HTMLFormElement;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const status = document.getElementById("form-status")!;
  const formError = document.getElementById("form-error")!;
  const label = button.textContent!;

  form.noValidate = true;

  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

  // Hidden context for the sheet: time zone, page, campaign tags.
  const params = new URLSearchParams(location.search);
  const utm = new URLSearchParams();
  for (const key of ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"]) {
    const value = params.get(key);
    if (value) utm.set(key, value.slice(0, 100));
  }
  // The short links /ig, /dm and /tt redirect to /?src=...
  const src = params.get("src");
  if (src && ["ig", "dm", "tt"].includes(src)) utm.set("src", src);
  field("tz").value = Intl.DateTimeFormat().resolvedOptions().timeZone ?? "";
  field("page").value = location.href.slice(0, 500);
  field("utm").value = utm.toString();

  // Messages come from src/i18n/en.ts (data-checks).
  const msg = JSON.parse(form.dataset.checks!) as Record<string, string>;
  const checks: Record<string, (v: string) => string> = {
    name: (v) => (v ? "" : msg.name!),
    email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? "" : msg.email!),
    phone: (v) => (normalizePhone(v) ? "" : msg.phone!),
    instagram: (v) => (v.replace(/^@/, "") ? "" : msg.instagram!),
  };
  const picked = (name: string) => !!form.querySelector(`input[name="${name}"]:checked`);

  function describe(el: HTMLElement, name: string, message: string) {
    const error = document.getElementById(`f-${name}-error`)!;
    error.textContent = message;
    error.hidden = !message;
    const help = document.getElementById(`f-${name}-help`);
    const ids = [help?.id, message ? error.id : ""].filter(Boolean).join(" ");
    if (ids) el.setAttribute("aria-describedby", ids);
    else el.removeAttribute("aria-describedby");
  }

  function show(name: string, message: string) {
    const input = field(name);
    if (message) input.setAttribute("aria-invalid", "true");
    else input.removeAttribute("aria-invalid");
    describe(input, name, message);
  }

  function showChoice(name: string, message: string) {
    describe(document.getElementById(`f-${name}`)!, name, message);
  }

  for (const name of Object.keys(checks)) {
    field(name).addEventListener("blur", () => {
      if (field(name).value.trim()) show(name, checks[name]!(field(name).value.trim()));
    });
    field(name).addEventListener("input", () => {
      if (field(name).hasAttribute("aria-invalid"))
        show(name, checks[name]!(field(name).value.trim()));
    });
  }
  for (const name of CHOICES) {
    document.getElementById(`f-${name}`)!.addEventListener("change", () => showChoice(name, ""));
  }

  async function send(body: URLSearchParams): Promise<"ok" | "invalid" | "fail"> {
    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/x-www-form-urlencoded",
        },
        body,
      });
      if (res.status === 400) return "invalid";
      const json = (await res.json().catch(() => null)) as { ok?: boolean } | null;
      return res.ok && json?.ok ? "ok" : "fail";
    } catch {
      return "fail";
    }
  }

  let sending = false;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending) return;
    formError.hidden = true;

    let firstBad: HTMLElement | null = null;
    for (const name of Object.keys(checks)) {
      const message = checks[name]!(field(name).value.trim());
      show(name, message);
      if (message && !firstBad) firstBad = field(name);
    }
    for (const name of CHOICES) {
      const message = picked(name) ? "" : msg.choice!;
      showChoice(name, message);
      if (message && !firstBad)
        firstBad = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
    }
    if (firstBad) {
      firstBad.focus();
      return;
    }

    field("sent_at").value = new Date().toISOString();
    sending = true;
    button.disabled = true;
    button.textContent = form.dataset.sending!;
    status.textContent = form.dataset.sending!;

    const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
    let result = await send(body);
    if (result === "fail") {
      // One automatic retry, so a brief network drop doesn't lose the lead.
      button.textContent = form.dataset.retrying!;
      await new Promise((r) => setTimeout(r, 800));
      result = await send(body);
    }

    if (result === "ok") {
      const next = new URLSearchParams({
        name: field("name").value.trim(),
        email: field("email").value.trim(),
      });
      location.assign(`${form.dataset.thanks}?${next}`);
      return;
    }
    sending = false;
    button.disabled = false;
    button.textContent = label;
    status.textContent = "";
    formError.hidden = false;
    formError.scrollIntoView({ block: "center" });
  });
</script>

<style>
  .form {
    display: grid;
    gap: var(--space-lg);
    width: 100%;
    max-width: 34rem;
  }
  .field {
    display: grid;
    gap: var(--space-xs);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  label,
  legend {
    font-weight: 600;
  }
  legend {
    padding: 0;
    margin-bottom: var(--space-xs);
  }
  input:not([type="hidden"]):not([type="radio"]),
  select,
  textarea {
    width: 100%;
    min-height: var(--tap);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid oklch(62% 0.01 70);
    border-radius: 0.75rem;
    background: var(--color-field);
    color: var(--color-ink);
    font: inherit;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  input:not([type="hidden"]):not([type="radio"]):hover,
  select:hover {
    border-color: var(--color-ink-muted);
  }
  input:not([type="hidden"]):not([type="radio"]):focus-visible,
  select:focus-visible {
    outline-offset: 1px;
    border-color: var(--color-accent);
    background: var(--color-card);
  }
  input[aria-invalid="true"] {
    border-color: var(--color-error);
    border-width: 2px;
  }

  /* Multiple choice: tap-sized chips that wrap; the real radio stays for keyboard and screen readers. */
  .choice__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid oklch(62% 0.01 70);
    border-radius: 999px;
    background: var(--color-field);
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--color-ink-muted);
  }
  .chip:has(:checked) {
    border-color: var(--color-accent);
    background: color-mix(in oklch, var(--color-accent) 16%, var(--color-card));
    font-weight: 600;
  }
  .chip:has(:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .help,
  .note,
  .dm {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .error {
    color: var(--color-error);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .error--form {
    display: grid;
    gap: var(--space-sm);
  }
  .error--form[hidden] {
    display: none;
  }
  .form__action {
    display: grid;
    gap: var(--space-sm);
  }
  .note a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
