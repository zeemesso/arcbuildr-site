---
/**
 * What the site shows around the application. The questions themselves are a form on Tally, opened in
 * Tally's popup by src/scripts/application.ts. This layer holds what comes after it: the calendar, or the
 * lines that end the form for a budget under the lowest price. It also holds the plain form (a name, an
 * email, one button), which opens when the questions cannot load. If the site's script stops, the
 * browser posts that form to the same endpoint itself.
 * `kind="prep"` is for someone who booked from a chat: the answers are saved and the page stays.
 */
import Logo from "../Logo.astro";
import { application as copy } from "../../content/site";

interface Props {
  kind?: "application" | "prep";
}
const { kind = "application" } = Astro.props;
const prep = kind === "prep";
const words = {
  /** Each question's id and its words, to recognize the answers Tally hands over. */
  questions: copy.questions.map(({ id, q }) => ({ id, q })),
  who: copy.who.map(({ id, q }) => ({ id, q })),
  tooLow: { id: copy.tooLow.id, option: copy.tooLow.option },
  errName: copy.who[0].err,
  errEmail: copy.who[1].err,
  send: copy.send,
  plainSend: copy.plain.send,
};
---

<div
  class="apply"
  data-apply
  data-kind={kind}
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={copy.label}
>
  <script is:inline type="application/json" data-apply-words set:html={JSON.stringify(words)} />
  <div class="apply__sheet">
    <header class="apply__top">
      <span class="apply__logo" inert>
        <Logo />
      </span>
      <button type="button" class="apply__x" data-close aria-label={copy.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </header>

    {/* The plain form. The script answers it; if the script stops, the browser posts it itself. */}
    <form class="apply__form" data-apply-form method="post" action="/api/apply" hidden>
      <input type="hidden" name="kind" value={kind} />
      <input type="hidden" name="ref" />
      <input type="hidden" name="tz" />
      <input type="hidden" name="page" />
      <div class="apply__trap" aria-hidden="true">
        <label>
          {copy.trap}
          <input type="text" name="company" tabindex="-1" autocomplete="off" data-trap />
        </label>
      </div>
      <div class="plain" data-apply-plain>
        <p class="plain__lead">{copy.plain.broken}</p>
        {copy.who.map((item) => (
          <label class="plain__field">
            <span class="plain__label">{item.q}</span>
            <input
              class="q__field"
              data-plain={item.id}
              name={item.id}
              type={item.id === "email" ? "email" : "text"}
              inputmode={item.id === "email" ? "email" : undefined}
              pattern={item.id === "email" ? "[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}" : undefined}
              required
              autocomplete={item.id === "email" ? "email" : "given-name"}
              autocapitalize={item.id === "email" ? "none" : "words"}
              autocorrect="off"
              spellcheck="false"
              maxlength={item.id === "email" ? 320 : 200}
              placeholder={item.ph}
            />
          </label>
        ))}
        <p class="q__err" data-plain-err role="alert"></p>
      </div>
      <footer class="apply__foot">
        <p class="apply__note" data-note role="status"></p>
        <div class="apply__actions">
          <button type="submit" class="apply__ok" data-ok>
            <span class="apply__spin" aria-hidden="true"></span>
            <span class="apply__ok-label" data-ok-label>
              {copy.plain.send}
            </span>
          </button>
          {!prep && (
            <a class="apply__anyway" data-anyway href="#" hidden>
              {copy.send.anyway}
            </a>
          )}
        </div>
      </footer>
    </form>

    {!prep && (
      <div class="apply__after" data-apply-after hidden>
        <div class="apply__end" data-apply-end hidden>
          {copy.tooLow.lines.map((line) => (
            <p data-line={line} />
          ))}
        </div>
        <div class="apply__cal" data-apply-calendar hidden>
          <h2 class="apply__cal-h" tabindex="-1">
            {copy.calendar.title}
          </h2>
          <div class="apply__cal-frame" data-calendar></div>
          <a class="apply__cal-link" data-calendar-link href="#" hidden>
            {copy.send.booked}
          </a>
        </div>
      </div>
    )}
  </div>
</div>
