---
/**
 * The application, as one swappable part.
 * "native" (APPLICATION_MODE in src/config.ts): our own form, one question per screen, in a layer on the
 * page that opened it. A page needs only this component and startApplication() from src/scripts/application.ts.
 * "embed": nothing is drawn here; the page's two fields send people to the form at APPLICATION_URL.
 * `kind="prep"` is the same form for someone who booked from a chat: it saves the answers and stays on the page.
 */
import "./application.css";
import Logo from "../Logo.astro";
import { application as copy } from "../../content/site";
import { APPLICATION_MODE } from "../../config";

interface Props {
  kind?: "application" | "prep";
}
const { kind = "application" } = Astro.props;
const prep = kind === "prep";
const letters = "ABCDEFGH";
const total = copy.questions.length;
const finish = prep ? copy.finishPrep : copy.finish;
const words = {
  hi: prep ? copy.hiPrep : copy.hi,
  again: copy.again,
  next: copy.next,
  finish,
  errName: copy.who[0].err,
  errEmail: copy.who[1].err,
  /** The last button and the saving line for someone who will not see a calendar. */
  finishShort: copy.finishPrep,
  send: {
    ...copy.send,
    saving: prep ? copy.send.savingPrep : copy.send.saving,
    savingShort: copy.send.savingPrep,
  },
  plain: copy.plain,
};
---

{APPLICATION_MODE === "native" && (
  <div
    class="apply"
    data-apply
    data-kind={kind}
    hidden
    role="dialog"
    aria-modal="true"
    aria-label={copy.label}
  >
    <script is:inline type="application/json" data-apply-words set:html={JSON.stringify(words)} />
    <div class="apply__sheet">
      <header class="apply__top">
        <span class="apply__logo" inert>
          <Logo />
        </span>
        <p class="apply__count" data-count-wrap>
          <b data-count>1</b>
          {` ${copy.of} ${total}`}
        </p>
        <button type="button" class="apply__x" data-close aria-label={copy.close}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
        <div
          class="apply__progress"
          role="progressbar"
          aria-label={copy.progress}
          aria-valuemin="0"
          aria-valuemax={total}
          aria-valuenow="0"
        >
          <span data-bar />
        </div>
      </header>

      {/* The script answers this form. If the script stops, the browser posts it to the same endpoint itself. */}
      <form class="apply__form" data-apply-form novalidate method="post" action="/api/apply">
        <input type="hidden" name="kind" value={kind} />
        <input type="hidden" name="ref" />
        <input type="hidden" name="tz" />
        <input type="hidden" name="page" />
        <div class="apply__trap" aria-hidden="true">
          <label>
            {copy.trap}
            <input type="text" name="company" tabindex="-1" autocomplete="off" data-trap />
          </label>
        </div>
        <div class="apply__stage" data-apply-stage>
          <div class="apply__body">
            <p class="apply__hi" data-hi />
            <div class="apply__steps">
              {copy.who.map((item) => (
                <section class="q" data-step data-who={item.id}>
                  <label class="q__label" data-part for={`a-${item.id}`}>
                    {item.q}
                  </label>
                  <input
                    class="q__field"
                    data-part
                    data-field
                    id={`a-${item.id}`}
                    name={`who-${item.id}`}
                    type={item.id === "email" ? "email" : "text"}
                    inputmode={item.id === "email" ? "email" : undefined}
                    autocomplete={item.id === "email" ? "email" : "given-name"}
                    autocapitalize={item.id === "email" ? "none" : "words"}
                    autocorrect="off"
                    spellcheck="false"
                    enterkeyhint="next"
                    maxlength={item.id === "email" ? 320 : 200}
                    placeholder={item.ph}
                    aria-describedby={`e-${item.id}`}
                  />
                  <p class="q__err" data-err id={`e-${item.id}`} role="alert" hidden>
                    {item.err}
                  </p>
                </section>
              ))}
              {copy.questions.map((item) => (
                <section class="q" data-step data-id={item.id} data-type={item.type}>
                  {item.type === "choice" ? (
                    <>
                      <p class="q__label" data-part id={`l-${item.id}`}>
                        {item.q}
                      </p>
                      <div
                        class="q__choices"
                        data-part
                        role="radiogroup"
                        aria-labelledby={`l-${item.id}`}
                        aria-describedby={`e-${item.id}`}
                      >
                        {item.options.map((option, k) => (
                          <label class="choice" style={`--k:${k}`}>
                            <input type="radio" name={item.id} value={option} />
                            <kbd aria-hidden="true">{letters[k]}</kbd>
                            <span>{option}</span>
                            <svg class="choice__tick" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M5 12.5l4.5 4.5L19 7.5" />
                            </svg>
                          </label>
                        ))}
                      </div>
                    </>
                  ) : (
                    <>
                      <label class="q__label" data-part for={`a-${item.id}`}>
                        {item.q}
                      </label>
                      {item.type === "long" ? (
                        <textarea
                          class="q__field"
                          data-part
                          data-field
                          id={`a-${item.id}`}
                          name={item.id}
                          rows="1"
                          maxlength="1000"
                          enterkeyhint="next"
                          placeholder={item.ph}
                          aria-describedby={`e-${item.id}`}
                        />
                      ) : (
                        <input
                          class="q__field"
                          data-part
                          data-field
                          id={`a-${item.id}`}
                          name={item.id}
                          type="text"
                          inputmode={item.type === "link" ? "url" : undefined}
                          autocapitalize={item.type === "link" ? "none" : undefined}
                          autocorrect={item.type === "link" ? "off" : undefined}
                          spellcheck={item.type === "link" ? "false" : undefined}
                          autocomplete="off"
                          maxlength="300"
                          enterkeyhint="next"
                          placeholder={item.ph}
                          aria-describedby={`e-${item.id}`}
                        />
                      )}
                    </>
                  )}
                  <p class="q__err" data-err id={`e-${item.id}`} role="alert" hidden>
                    {item.err}
                  </p>
                </section>
              ))}
            </div>
            {/* The plain form: it takes the questions' place when saving fails, or when the script stops. */}
            <div class="plain" data-apply-plain hidden>
              {copy.who.map((item) => (
                <label class="plain__field">
                  <span class="plain__label">{item.q}</span>
                  <input
                    class="q__field"
                    data-plain={item.id}
                    name={item.id}
                    type={item.id === "email" ? "email" : "text"}
                    inputmode={item.id === "email" ? "email" : undefined}
                    pattern={item.id === "email" ? "[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}" : undefined}
                    autocomplete={item.id === "email" ? "email" : "given-name"}
                    autocapitalize={item.id === "email" ? "none" : "words"}
                    autocorrect="off"
                    spellcheck="false"
                    maxlength={item.id === "email" ? 320 : 200}
                    placeholder={item.ph}
                  />
                </label>
              ))}
              <p class="q__err" data-plain-err role="alert" />
            </div>
          </div>
        </div>

        <footer class="apply__foot">
          <p class="apply__note" data-note role="status" />
          <div class="apply__actions">
            <button type="button" class="apply__back" data-back aria-label={copy.back}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.5 5.5 8 12l6.5 6.5" />
              </svg>
            </button>
            <button type="submit" class="apply__ok" data-ok>
              <span class="apply__spin" aria-hidden="true" />
              <span class="apply__ok-label" data-ok-label>
                {copy.next}
              </span>
            </button>
            <a class="apply__anyway" data-anyway href="#" hidden>
              {copy.send.anyway}
            </a>
            <span class="apply__hint" aria-hidden="true">
              {copy.enter} <kbd>↵</kbd>
            </span>
          </div>
        </footer>
      </form>

      {!prep && (
        <div class="apply__after" data-apply-after hidden>
          <div
            class="apply__end"
            data-apply-end
            data-id={copy.tooLow.id}
            data-option={copy.tooLow.option}
            hidden
          >
            {copy.tooLow.lines.map((line) => (
              <p data-line={line} />
            ))}
          </div>
          <div class="apply__cal" data-apply-calendar hidden>
            <h2 class="apply__cal-h" tabindex="-1">
              {copy.calendar.title}
            </h2>
            <div class="apply__cal-frame" data-calendar />
            <a class="apply__cal-link" data-calendar-link href="#" hidden>
              {copy.send.booked}
            </a>
          </div>
        </div>
      )}
    </div>
  </div>
)}
