---
import { sample } from "../content/site";
/** The sample episode as a document. The home page shows its title and first line; /sample shows all of it. */
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
const { doc } = sample;
const rows = full ? doc.rows : doc.rows.slice(0, 1);
---

<div class:list={["script", full && "script--full"]}>
  {full && (
    <p class="script__code">
      {doc.code}
      <span>{doc.length}</span>
    </p>
  )}
  <p class="script__title">{doc.title}</p>
  {rows.map((row) => (
    <div class="script__row">
      <p class="script__t">{row.t}</p>
      <p class="script__say">
        <b>{doc.sayHead}</b>
        {row.say}
      </p>
      {full && (
        <p class="script__show">
          <b>{doc.showHead}</b>
          {row.show}
        </p>
      )}
    </div>
  ))}
  {full && (
    <p class="script__caption">
      <b>{doc.captionLabel}</b>
      {doc.caption}
    </p>
  )}
</div>
