---
import Logo from "./Logo.astro";
import { action } from "../content/site";
interface Props {
  apply?: boolean;
}
const { apply = true } = Astro.props;
---

<header class="top">
  <div class="top__pill">
    <Logo />
    {apply && (
      <a class="btn btn--small" href={Astro.url.pathname === "/" ? "#apply" : "/#apply"} data-apply>
        {action}
      </a>
    )}
  </div>
</header>
