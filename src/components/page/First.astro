---
/**
 * 1. First screen (DESIGN.md, section 15): who it is for, the headline at display size, one sentence,
 * the two buttons side by side, one small line, then the video frame.
 * Behind the words a trail of soft square pixels follows the pointer and fades (src/scripts/page.ts
 * draws it into [data-trail]); it is decoration, so it is hidden from a screen reader.
 * The second button carries the Claude and ChatGPT marks and leads to What you get.
 * The video frame is always there, 16:9: the film once VSL_VIDEO is set, a poster with a play mark and
 * no words until then.
 * The three wins follow it (Wins.astro).
 */
import Marks from "./Marks.astro";
import Vsl from "./Vsl.astro";
import { section } from "../../content/deck";
interface Props {
  /** The sales video's file, or "" while there is none. */
  film: string;
}
const { film } = Astro.props;
const s = section(1);
const headline = s.get("headline");
---

<section class="first" id="top" aria-labelledby="first-h" data-first>
  <div class="trail" data-trail aria-hidden="true"></div>
  <div class="first__words">
    <p class="first__for" data-enter style="--i:0">
      {s.get("label above the headline")}
    </p>
    <h1 class="first__h" id="first-h" data-enter style="--i:1">
      {headline}
    </h1>
    <p class="first__line" data-enter style="--i:2">
      {s.get("line under it")}
    </p>
  </div>
  <div class="first__foot" data-enter style="--i:3">
    <div class="first__actions">
      <a class="btn" href="#apply" data-apply-open data-cta>
        {s.get("button")}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a class="btn btn--quiet" href="#get" data-see>
        <Marks />
        {s.get("see everything button")}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </div>
    <p class="first__under">{s.get("under the button")}</p>
  </div>
  <div class="first__watch" data-enter style="--i:4">
    <Vsl src={film} title={headline} />
  </div>
</section>
