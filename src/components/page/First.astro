---
/**
 * The first screen: who it is for, the headline, one sentence, then the sales video (a 16:9 slot),
 * the two actions and his face beside "with me". The three wins follow it (Wins.astro).
 */
import Marks from "./Marks.astro";
import Vsl from "./Vsl.astro";
import { founding, labelled, section } from "../../content/deck";
import { FOUNDING_PLACES_LEFT } from "../../config";
import Face from "./Face.astro";
const s = section(1);
const headline = s.find("headline") ?? s.get("headline, option 1");
const line = labelled(s.get("line under it"));
---

<section class="first" id="top" aria-labelledby="first-h">
  <div class="first__words">
    <p class="label" data-enter style="--i:0">
      {s.get("label above the headline")}
    </p>
    <h1 class="first__h" id="first-h" data-enter style="--i:1">
      {headline}
    </h1>
    <p class="first__line" data-enter style="--i:2">
      {line.map((part) => (part.label ? <span class="chip">{part.text}</span> : part.text))}
    </p>
  </div>
  <Vsl title={headline} />
  <div class="first__foot" data-enter style="--i:4">
    <div class="first__actions">
      <a class="btn" href="#apply" data-apply-open data-cta>
        {s.get("button")}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a class="btn btn--quiet" href="#get">
        <Marks />
        {s.get("second button, with the Claude and ChatGPT icons")}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </div>
    <div class="who">
      <Face size={40} class="who__face" />
      <p class="who__note">{s.get("under the buttons")}</p>
    </div>
    <p class="first__places">
      <span class="hang__dots" aria-hidden="true">
        {[0, 1, 2].map((n) => (
          <i data-taken={n >= FOUNDING_PLACES_LEFT ? "" : undefined} />
        ))}
      </span>
      {founding(s.get("hanging tab"))}
    </p>
  </div>
</section>
