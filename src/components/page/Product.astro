---
/**
 * The product card: our own product, shown as a product page in small. Its label, its name, its price,
 * one line, what it is, what's inside, and what it needs. The cover is drawn (the arc, on a dark sheet
 * with two sheets behind it); every word is the deck's (section 9, "add-on").
 */
import { section } from "../../content/deck";
const s = section(9);
const value = s.get("add-on, value");
/** The figure in the price line ("147 USD") is set apart. */
const figure = /[\d,]+ USD/.exec(value);
const parts = figure
  ? [value.slice(0, figure.index), figure[0], value.slice(figure.index + figure[0].length)]
  : [value, "", ""];
/** "The method: how a piece is made." → the name leads, the rest explains it. */
const inside = s.list("inside ").map(({ words }) => {
  const cut = words.indexOf(": ");
  return cut < 0
    ? (["", words] as const)
    : ([words.slice(0, cut + 1), words.slice(cut + 2)] as const);
});
---

<article class="product" data-product data-reveal aria-labelledby="product-h">
  <div class="product__shot" aria-hidden="true">
    <span class="product__sheet"></span>
    <span class="product__sheet"></span>
    <span class="product__cover">
      <svg viewBox="0 0 120 150" focusable="false">
        <path class="product__ring" d="M14 118 A 46 46 0 0 1 106 118"></path>
        <path class="product__ring" d="M30 118 A 30 30 0 0 1 90 118"></path>
        <path class="product__arc" d="M46 118 A 14 14 0 0 1 74 118"></path>
      </svg>
    </span>
  </div>
  <div class="product__words">
    <p class="product__label">{s.get("add-on, label")}</p>
    <h3 class="product__name" id="product-h">
      {s.get("add-on, name")}
    </h3>
    <p class="product__value">
      {parts[0]}
      {parts[1] && <b>{parts[1]}</b>}
      {parts[2]}
    </p>
    <p class="product__line">{s.get("add-on, line")}</p>
    <p class="product__body">{s.get("add-on, body")}</p>
  </div>
  <div class="product__inside">
    <h4>{s.get("add-on, inside title")}</h4>
    <ul>
      {inside.map(([name, rest]) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.5 12.5l3.5 3.5 7.5-8" />
          </svg>
          <span>
            {name && <b>{name}</b>} {rest}
          </span>
        </li>
      ))}
    </ul>
    <p class="product__small">{s.get("add-on, small line")}</p>
  </div>
</article>
