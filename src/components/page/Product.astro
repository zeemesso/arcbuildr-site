---
/**
 * The product card: our own product, shown as a product page in small, in its own frame. Its label, its
 * name, its price and what it is; the flow from an idea to a piece (three steps, each with a small
 * drawing); one moving sample (screens/Sample.astro); what's inside; and what it runs in, by name only.
 * Every word is the deck's (section 8, "add-on", "flow", "inside", "sample").
 */
import Sample from "./screens/Sample.astro";
import { section } from "../../content/deck";
const s = section(8);
const value = s.get("add-on, value");
/** The figure in the price line ("147 USD") is set apart. */
const figure = /[\d,]+ USD/.exec(value);
const parts = figure
  ? [value.slice(0, figure.index), figure[0], value.slice(figure.index + figure[0].length)]
  : [value, "", ""];
/** "The method: how a piece is made." → the name leads, the rest explains it. */
const inside = s.list("inside ").map(({ words }) => {
  const cut = words.indexOf(": ");
  return cut < 0
    ? (["", words] as const)
    : ([words.slice(0, cut + 1), words.slice(cut + 2)] as const);
});
const flow = s.list("flow ").filter(({ slot }) => /^flow \d+$/.test(slot));
---

<article class="product" data-product data-reveal aria-labelledby="product-h">
  <div class="product__words">
    <p class="product__label">{s.get("add-on, label")}</p>
    <h3 class="product__name" id="product-h">
      {s.get("add-on, name")}
    </h3>
    <p class="product__value">
      {parts[0]}
      {parts[1] && <b>{parts[1]}</b>}
      {parts[2]}
    </p>
    <p class="product__line">{s.get("add-on, line")}</p>
    <p class="product__body">{s.get("add-on, body")}</p>

    <div class="pflow" data-flow-picture>
      <h4>{s.get("flow title")}</h4>
      <ol>
        <li>
          <span class="pflow__pic pflow__pic--idea" aria-hidden="true">
            <i></i>
            <i></i>
          </span>
          <p>{flow[0]?.words}</p>
        </li>
        <li>
          <span class="pflow__pic pflow__pic--piece" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </span>
          <p>{flow[1]?.words}</p>
        </li>
        <li>
          <span class="pflow__pic pflow__pic--checks" aria-hidden="true">
            {Array.from({ length: 10 }, () => (
              <i />
            ))}
          </span>
          <p>{flow[2]?.words}</p>
        </li>
      </ol>
    </div>
  </div>

  <Sample />

  <div class="product__inside">
    <h4>{s.get("add-on, inside title")}</h4>
    <ul>
      {inside.map(([name, rest]) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.5 12.5l3.5 3.5 7.5-8" />
          </svg>
          <span>
            {name && <b>{name}</b>} {rest}
          </span>
        </li>
      ))}
    </ul>
    <div class="product__small">
      <p>{s.get("add-on, small line")}</p>
      <p data-credit>{s.get("add-on, credit")}</p>
    </div>
  </div>
</article>
