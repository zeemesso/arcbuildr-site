---
/**
 * 5. What you get: seven numbered cards, each with its date, the step of the Show it comes from, what
 * it does, and a screen. A screen is a picture of the real document; until that picture exists it is
 * the card's own title on a plain panel. Card 05 is wide. An apply strip closes the section.
 */
import Card from "./Card.astro";
import Strip from "./Strip.astro";
import { section } from "../../content/deck";
const s = section(5);
const numbers = s
  .list("card ")
  .filter(({ slot }) => slot.endsWith(", title"))
  .map(({ slot }) => slot.slice(5, 7));
---

<section class="get" id="get" aria-labelledby="get-h">
  <div class="get__head">
    <p class="label" data-reveal>
      {s.get("label")}
    </p>
    <h2 class="h2" id="get-h" data-reveal>
      {s.get("heading")}
    </h2>
  </div>
  <ol class="cards">
    {numbers.map((n) => (
      <Card n={n} wide={n === "05"} />
    ))}
  </ol>
  <p class="get__after" data-reveal>
    {s.get("line under the cards")}
  </p>
  <Strip from={5} />
</section>
