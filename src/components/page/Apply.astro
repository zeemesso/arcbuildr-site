---
/**
 * 12. Apply: the final dark window. The heading, the first screen's sentence, the two fields and the
 * button, the founding count beside it, and three small steps in a row.
 * Without scripts, or when the page's script fails, the browser posts the two fields itself to
 * POST /api/apply: the name and email are saved, and the person goes on to the booking page with both filled.
 */
import { founding, section } from "../../content/deck";
import { auditPicture } from "../../content/proof";
const s = section("the apply window");
const steps = s.list("step ").map(({ words }) => words);
// His own audit, beside the two fields, once the picture exists (the deck's `audit picture`).
const audit = s.find("audit picture") !== undefined ? auditPicture() : null;
const under = founding(s.get("under the button"));
---

<section class="window window--night final" id="apply" aria-labelledby="final-h">
  <div class="final__words">
    <p class="label" data-reveal>
      {s.get("label")}
    </p>
    <h2 class="final__h" id="final-h" data-reveal>
      {s.get("heading")}
    </h2>
    <p class="final__line" data-reveal>
      {s.get("line under it")}
    </p>
    <p class="final__p" data-reveal>
      {s.get("paragraph")}
    </p>
  </div>
  <div class="final__box" data-reveal>
    <form class="entry" action="/api/apply" method="post" data-apply-entry data-cta>
      <label class="entry__field">
        <span class="sr-only">{s.get("field 1")}</span>
        <input
          name="name"
          autocomplete="given-name"
          autocapitalize="words"
          placeholder={s.get("field 1")}
          enterkeyhint="next"
          maxlength="200"
          required
        />
        <span class="entry__err" data-entry-err role="alert"></span>
      </label>
      <label class="entry__field">
        <span class="sr-only">{s.get("field 2")}</span>
        <input
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          autocapitalize="none"
          spellcheck="false"
          placeholder={s.get("field 2")}
          enterkeyhint="go"
          maxlength="320"
          required
          pattern={"[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}"}
        />
        <span class="entry__err" data-entry-err role="alert"></span>
      </label>
      <button class="btn" type="submit">
        {s.get("button")}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>
    </form>
    <p class="final__under">{under}</p>
    {audit && (
      <img
        class="final__audit"
        src={audit.image}
        alt={audit.alt}
        width={audit.width}
        height={audit.height}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <ol class="final__steps">
    {steps.map((words, n) => (
      <li data-reveal style={`--i:${n}`}>
        <b>{n + 1}</b>
        <span>{words}</span>
      </li>
    ))}
  </ol>
</section>
