---
/**
 * The bonus stack: each bonus is an item with a cover, its name and its value, one above the other.
 * The covers are drawn; the names and the values are the deck's.
 */
interface Props {
  items: { n: string; name: string; value: string }[];
}
const { items } = Astro.props;
---

<ol class="bonuses" data-bonuses>
  {items.map(({ n, name, value }, at) => (
    <li class="bonus" data-reveal style={`--i:${at};--tone:var(--bonus-${(at % 4) + 1})`}>
      <span class="bonus__cover" aria-hidden="true">
        <svg viewBox="0 0 64 64" focusable="false">
          <path d="M8 50 A 24 24 0 0 1 56 50" />
          <path d="M20 50 A 12 12 0 0 1 44 50" />
        </svg>
      </span>
      <span class="bonus__n">{n}</span>
      <span class="bonus__name">{name}</span>
      <span class="bonus__value">{value}</span>
    </li>
  ))}
</ol>
