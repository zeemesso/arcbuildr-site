---
/**
 * The bonuses: each is a small card with its name, its value, which packages hold it and what it
 * removes. Every word is the deck's.
 */
interface Props {
  items: { name: string; value: string; held: string; body: string }[];
}
const { items } = Astro.props;
---

<ol class="bonuses" data-bonuses>
  {items.map(({ name, value, held, body }, at) => (
    <li class="bonus" data-reveal style={`--i:${at}`}>
      <p class="bonus__held">{held}</p>
      <h4 class="bonus__name">{name}</h4>
      <span class="bonus__value">{value}</span>
      <p class="bonus__body">{body}</p>
    </li>
  ))}
</ol>
