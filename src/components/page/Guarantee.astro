---
/**
 * 10. Guarantee: one quiet window, large type, no picture. A small timeline of three marks: day 1,
 * day 7, day 10, with the stretch from day 7 to day 10 highlighted.
 */
import { section } from "../../content/deck";
import { page } from "../../content/site";
const s = section(10);
const paragraphs = s.list("paragraph").map(({ words }) => words);
---

<section class="promise" id="guarantee" aria-labelledby="promise-h">
  <div class="promise__top">
    <p class="label" data-reveal>
      {s.get("label")}
    </p>
    <h2 class="promise__h" id="promise-h" data-reveal>
      {s.get("heading")}
    </h2>
  </div>
  <ol class="days" data-reveal aria-hidden="true">
    {page.guarantee.marks.map((mark) => (
      <li>
        <i />
        <span>{mark}</span>
      </li>
    ))}
  </ol>
  <div class="promise__words">
    <p class="promise__first" data-reveal>
      {paragraphs[0]}
    </p>
    {paragraphs.slice(1).map((words) => (
      <p data-reveal>{words}</p>
    ))}
  </div>
</section>
