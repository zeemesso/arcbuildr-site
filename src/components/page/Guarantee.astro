---
/**
 * 9. Guarantee: one quiet window, large type, no picture and no dates.
 */
import { section } from "../../content/deck";
const s = section(9);
const paragraphs = s.list("paragraph").map(({ words }) => words);
---

<section class="promise" id="guarantee" aria-labelledby="promise-h">
  <div class="promise__top">
    <p class="label" data-reveal>
      {s.get("label")}
    </p>
    <h2 class="promise__h" id="promise-h" data-reveal>
      {s.get("heading")}
    </h2>
  </div>
  <div class="promise__words">
    <p class="promise__first" data-reveal>
      {paragraphs[0]}
    </p>
    {paragraphs.slice(1).map((words) => (
      <p data-reveal>{words}</p>
    ))}
  </div>
</section>
