---
/**
 * 11. Questions: numbered rows that open and close, the first one open, the heading in a left column.
 * The rows are <details>, so they work without scripts.
 */
import { section } from "../../content/deck";
const s = section(11);
const questions = s.list("question ").map(({ slot, words }) => {
  const n = slot.split(" ")[1];
  // "answer 1" and "answer 1, …" are its paragraphs; "answer 10" is another question's.
  const answers = s
    .list(`answer ${n}`)
    .filter((item) => item.slot === `answer ${n}` || item.slot.startsWith(`answer ${n},`));
  return { n, q: words, a: answers.map((item) => item.words) };
});
---

<section class="faq" id="questions" aria-labelledby="faq-h">
  <div class="faq__head">
    <p class="label" data-reveal>
      {s.get("label")}
    </p>
    <h2 class="h2" id="faq-h" data-reveal>
      {s.get("heading")}
    </h2>
  </div>
  <div class="faq__rows">
    {questions.map(({ n, q, a }, i) => (
      <details class="faq__row" name="questions" open={i === 0} data-reveal>
        <summary>
          <span class="faq__n">{String(n).padStart(2, "0")}</span>
          <span class="faq__q">{q}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <div class="faq__a">
          {a.map((words) => (
            <p>{words}</p>
          ))}
        </div>
      </details>
    ))}
  </div>
</section>
