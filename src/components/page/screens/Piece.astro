---
/**
 * Screen 05: one content piece. What to say moves up the page, the shots line up beside it, then the
 * card with the points to say turns over, one line of it marked.
 */
import Cap from "./Cap.astro";
import { labels } from "../../../content/screens";
const [say, shots, card, keep] = labels("05");
const lines = [
  "92%",
  "100%",
  "84%",
  "96%",
  "70%",
  "100%",
  "88%",
  "94%",
  "62%",
  "98%",
  "80%",
  "90%",
];
---

<figure class="screen s5" data-loop="10000" aria-hidden="true">
  <div class="s5__script">
    <Cap text={say} at={150} class="pop" />
    <div class="s5__roll" data-at="900">
      <div class="bars typed" data-at="350">
        {lines.map((width, k) => (
          <i style={`--w:${width};--k:${k}`} />
        ))}
      </div>
    </div>
  </div>
  <div class="s5__side">
    <div class="s5__shots">
      <Cap text={shots} at={1300} class="pop" />
      <ol>
        {["70%", "86%", "58%"].map((width, n) => (
          <li class="pop" data-at={1500 + n * 220}>
            <b>{n + 1}</b>
            <span class="bars">
              <i style={`--w:${width}`} />
            </span>
          </li>
        ))}
      </ol>
    </div>
    <div class="s5__card" data-at="2500">
      <div class="s5__back"></div>
      <div class="s5__face">
        {card && <p class="cap">{card}</p>}
        <ul class="bars">
          {["82%", "94%", "66%"].map((width, n) => (
            <li class:list={{ "is-kept": n === 1 }}>
              <i class:list={{ "is-strong": n === 1 }} style={`--w:${width}`} />
            </li>
          ))}
        </ul>
      </div>
    </div>
    <Cap text={keep} at={3200} class="pop s5__keep" />
  </div>
</figure>
