---
/**
 * Screen 09: a Monday message. It is typed, then sent; a question comes back and is answered.
 * Bars until the real message from week 2 of Zyade's own season exists.
 */
import T from "./T.astro";
import Tick from "./Tick.astro";
import { excerpt, section } from "../../../content/deck";
import { piece } from "../../../content/proof";
const s = section(5);
const body = s.get("card 09, body");
const real = piece("monday-message");
const caps = [
  excerpt(s.get("card 09, date"), "Every Monday"),
  excerpt(body, "what comes next this week"),
  excerpt(body, "I answer within 24 hours"),
];
const widths = ["94%", "100%", "86%", "97%", "58%"];
const lines: (string | undefined)[] = real ? real.lines.slice(0, 6) : widths.map(() => undefined);
---

<figure class="screen s9" data-loop="10000" aria-hidden={real ? undefined : "true"}>
  <p class="cap s9__day pop" data-at="150">
    {caps[0]}
  </p>
  <div class="s9__msg" data-at="2300">
    <p class="cap">{caps[1]}</p>
    <div class="bars typed" data-at="400">
      {lines.map((line, k) => (
        <T text={line} w={widths[k % widths.length]!} k={k} />
      ))}
    </div>
    <span class="s9__sent" data-at="2500">
      <Tick />
    </span>
  </div>
  <div class="s9__ask pop" data-at="3100">
    <span class="bars">
      <T w="78%" />
      <T w="46%" />
    </span>
  </div>
  <div class="s9__answer pop" data-at="3900">
    <p class="cap">{caps[2]}</p>
    <span class="bars">
      <T w="88%" strong />
      <T w="62%" strong />
    </span>
  </div>
</figure>
