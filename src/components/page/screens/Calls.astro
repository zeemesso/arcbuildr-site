---
/**
 * Screen 07: the three calls. The setup checklist ticks itself, then the three calls take their place
 * on a line. Bars until the real checklist exists.
 */
import T from "./T.astro";
import Tick from "./Tick.astro";
import { excerpt, section } from "../../../content/deck";
import { piece } from "../../../content/proof";
const body = section(5).get("card 07, body");
const real = piece("setup-checklist");
const cap = excerpt(body, "a checklist you keep");
const calls = [
  excerpt(body, "20-minute setup call"),
  excerpt(body, "week 4"),
  excerpt(body, "week 8"),
];
const widths = ["72%", "88%", "60%", "80%", "68%"];
const items: (string | undefined)[] = real ? real.items.slice(0, 5) : widths.map(() => undefined);
---

<figure class="screen s7" data-loop="10000" aria-hidden={real ? undefined : "true"}>
  <div class="s7__sheet">
    <p class="cap pop" data-at="150">
      {cap}
    </p>
    <ul class="s7__list">
      {items.map((item, n) => (
        <li data-at={600 + n * 320}>
          <span class="s7__box">
            <Tick />
          </span>
          <span class="bars">
            <T text={item} w={widths[n]!} />
          </span>
        </li>
      ))}
    </ul>
  </div>
  <ol class="s7__calls">
    {calls.map((call, n) => (
      <li class="pop" data-at={2400 + n * 220}>
        <b>{n + 1}</b>
        <span>{call}</span>
      </li>
    ))}
  </ol>
</figure>
