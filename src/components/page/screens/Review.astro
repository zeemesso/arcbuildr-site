---
/**
 * Screen 08: a group review. One of the owners' videos is on, its time runs, and the notes appear
 * beside it. Bars until Zyade's real review of one of his own videos exists.
 */
import T from "./T.astro";
import { excerpt, section } from "../../../content/deck";
import { piece } from "../../../content/proof";
const body = section(5).get("card 08, body");
const real = piece("review");
const caps = [excerpt(body, "12 owners at most"), excerpt(body, "about 10 minutes on yours")];
const notes: (string | undefined)[] = real
  ? real.notes.slice(0, 3)
  : [undefined, undefined, undefined];
const widths = [
  ["90%", "64%"],
  ["82%", "48%"],
  ["94%", "70%"],
];
---

<figure class="screen s8" data-loop="10000" aria-hidden={real ? undefined : "true"}>
  <div class="s8__room pop" data-at="150">
    <p class="cap">{caps[0]}</p>
    <ul>
      {Array.from({ length: 12 }, (_, n) => (
        <li class:list={{ "is-you": n === 4 }} />
      ))}
    </ul>
  </div>
  <div class="s8__video pop" data-at="500">
    {real?.still ? <img src={real.still} alt="" loading="lazy" /> : <i class="s8__person"></i>}
    <i class="s8__time" data-at="900"></i>
  </div>
  <div class="s8__notes">
    <p class="cap pop" data-at="900">
      {caps[1]}
    </p>
    <ul>
      {notes.map((note, n) => (
        <li class="pop bars" data-at={1300 + n * 500}>
          {note ? <T text={note} /> : widths[n]!.map((w) => <T w={w} />)}
        </li>
      ))}
    </ul>
  </div>
</figure>
