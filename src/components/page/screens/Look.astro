---
/**
 * Screen 03: the Visual Identity System. The colors fill in, the fonts are set, then one frame snaps to
 * the framing lines. Until the real piece exists the colors are greys and the fonts are bars.
 */
import T from "./T.astro";
import { excerpt, section } from "../../../content/deck";
import { piece } from "../../../content/proof";
const body = section(5).get("card 03, body");
const real = piece("visual-identity");
const caps = [
  excerpt(body, "3 to 5 colors"),
  excerpt(body, "1 or 2 fonts"),
  excerpt(body, "how to frame the shot"),
];
const tones = [84, 62, 42, 24, 11].map(
  (ink) => `color-mix(in oklch, var(--color-ink) ${ink}%, var(--color-card))`,
);
const colors = real ? real.colors : tones;
const fonts = real ? real.fonts : [undefined, undefined];
const fontsAt = 600 + colors.length * 220 + 200;
---

<figure class="screen s3" data-loop="10000" aria-hidden={real ? undefined : "true"}>
  <div class="s3__sheet">
    <p class="cap pop" data-at="200">
      {caps[0]}
    </p>
    <ul class="s3__colors">
      {colors.map((color, n) => (
        <li class="pop" data-at={600 + n * 220} style={`--c:${color}`} />
      ))}
    </ul>
    <p class="cap pop" data-at={fontsAt}>
      {caps[1]}
    </p>
    <ul class="s3__fonts">
      {fonts.map((font, n) => (
        <li class="bars typed" data-at={fontsAt + 250 + n * 250}>
          <T text={font} w={n ? "46%" : "72%"} strong={n === 0} />
        </li>
      ))}
    </ul>
  </div>
  <div class="s3__frame" data-at="2500">
    <i class="s3__lines"></i>
    <i class="s3__person"></i>
  </div>
  <p class="cap s3__cap pop" data-at="2300">
    {caps[2]}
  </p>
</figure>
