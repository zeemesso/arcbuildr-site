---
/**
 * Screen 02: the public profile. Each old field fades and the rewritten one takes its place, then the
 * three things to pin move into their order. It reads the real piece (src/content/proof.ts);
 * until it exists the fields are bars. The captions are pieces of the card's own words.
 */
import { excerpt, section } from "../../../content/deck";
import { piece } from "../../../content/proof";
const s = section(5);
const body = s.get("card 02, body");
const real = piece("profile");
const pinCap = excerpt(body, "what to pin and in what order");
const badge = excerpt(body, "ready to paste");
// Bars for a profile that is not here yet: [old lines], [new lines].
const empty = [
  { old: ["52%"], now: ["68%"] },
  { old: ["38%"], now: ["46%"] },
  { old: ["100%", "44%"], now: ["100%", "86%"] },
  { old: ["30%"], now: ["58%"] },
];
const fields = real
  ? real.fields.map((field) => ({ old: [field.before], now: [field.after] }))
  : empty;
const head = fields.slice(0, 2);
const rest = fields.slice(2);
const at = (n: number) => 900 + n * 400;
const done = at(fields.length);
// The pins start out of order (3, 1, 2) and move into place.
const from = [1, 1, -2];
---

<figure class="screen" data-loop="10000" aria-hidden={real ? undefined : "true"}>
  <div class="pf">
    <div class="pf__head">
      <i class="pf__avatar"></i>
      <div class="pf__stack">
        {head.map((field, n) => (
          <div class="fld" data-at={at(n)}>
            <div class="fld__old">
              {field.old.map((line) => (real ? <span>{line}</span> : <i style={`--w:${line}`} />))}
            </div>
            <div class="fld__new">
              {field.now.map((line, k) =>
                real ? <span>{line}</span> : <i style={`--w:${line};--k:${k}`} />,
              )}
            </div>
            <span class="fld__ok">
              <svg viewBox="0 0 24 24">
                <path d="M6.5 12.5l3.5 3.5 7.5-8" />
              </svg>
            </span>
          </div>
        ))}
      </div>
    </div>
    <i class="pf__rule"></i>
    <div class="pf__stack">
      {rest.map((field, n) => (
        <div class="fld" data-at={at(n + head.length)}>
          <div class="fld__old">
            {field.old.map((line) => (real ? <span>{line}</span> : <i style={`--w:${line}`} />))}
          </div>
          <div class="fld__new">
            {field.now.map((line, k) =>
              real ? <span>{line}</span> : <i style={`--w:${line};--k:${k}`} />,
            )}
          </div>
          <span class="fld__ok">
            <svg viewBox="0 0 24 24">
              <path d="M6.5 12.5l3.5 3.5 7.5-8" />
            </svg>
          </span>
        </div>
      ))}
    </div>
  </div>
  <div class="pf__side">
    <p class="cap" data-at={done}>
      {pinCap}
    </p>
    <ol class="pf__pins" data-at={done + 250}>
      {from.map((offset, n) => (
        <li style={`--from:${offset};--k:${n}`}>
          <b>{n + 1}</b>
        </li>
      ))}
    </ol>
  </div>
  <p class="pf__badge" data-at={done + 900}>
    <svg viewBox="0 0 24 24">
      <path d="M6.5 12.5l3.5 3.5 7.5-8" />
    </svg>
    {badge}
  </p>
</figure>
