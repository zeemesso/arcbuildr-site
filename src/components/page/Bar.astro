---
/** The header: a dark pill that follows the page. Its button is always there, at every scroll position and width. */
import Logo from "../Logo.astro";
import { page } from "../../content/site";
interface Props {
  /** The sections the pill links to: the section's own label, and its id. */
  links?: { text: string; href: string }[];
  /** False on a page with nothing to apply to. */
  cta?: boolean;
}
const { links = [], cta = true } = Astro.props;
---

<header class="bar">
  <div class="bar__pill">
    <Logo />
    {links.length > 0 && (
      <nav class="bar__links" aria-label={page.nav}>
        {links.map((link) => (
          <a href={link.href}>{link.text}</a>
        ))}
      </nav>
    )}
    {cta && (
      <a class="bar__cta" href="#apply" data-apply-open>
        <span>{page.pill}</span>
      </a>
    )}
  </div>
</header>
