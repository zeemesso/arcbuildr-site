---
/** The three wins under the first screen: a title and one line each, in the deck's words (section 1). */
import { section } from "../../content/deck";
const s = section(1);
const wins = s
  .list("win ")
  .filter(({ slot }) => slot.endsWith(", title"))
  .map(({ slot, words }) => ({ title: words, line: s.get(slot.replace(", title", ", line")) }));
---

<ul class="wins" data-wins>
  {wins.map(({ title, line }, n) => (
    <li data-reveal style={`--i:${n}`}>
      <span class="wins__n">{String(n + 1).padStart(2, "0")}</span>
      <h2 class="wins__h">{title}</h2>
      <p>{line}</p>
    </li>
  ))}
</ul>
