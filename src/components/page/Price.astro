---
/**
 * The offer: the pieces of the service beside what the same work costs hired out, then the digital
 * product as a product card and the bonuses as a stack, each with its name and its value, then the
 * total and the founding price, the six prices and the founding places. An apply strip closes it.
 */
import Strip from "./Strip.astro";
import Product from "./Product.astro";
import Bonuses from "./Bonuses.astro";
import { founding, section } from "../../content/deck";
import { FOUNDING_PLACES_LEFT } from "../../config";
const s = section(8);
/** The deck writes a row as sentences; on the page each sentence is a cell. */
const cells = (words: string) => words.replace(/\.$/, "").split(". ");
const rows = s.list("stack row ").map(({ words }, at) => {
  const cut = words.indexOf(". ");
  return {
    n: String(at + 1).padStart(2, "0"),
    name: words.slice(0, cut),
    value: words.slice(cut + 2).replace(/\.$/, ""),
  };
});
// The stack has three kinds of row, told apart by what stands where a price would:
// a figure alone is a piece of the service; a sentence with a figure is the product we will also sell
// alone; no figure is a bonus.
const pieces = rows.filter(({ value }) => /^[\d,]+ USD$/.test(value));
const products = rows.filter(({ value }) => /\d/.test(value) && !/^[\d,]+ USD$/.test(value));
const bonuses = rows.filter(({ value }) => !/\d/.test(value));
const sum = (words: string) => {
  const cut = words.lastIndexOf(": ");
  return [words.slice(0, cut), words.slice(cut + 2).replace(/\.$/, "")] as const;
};
const total = sum(s.get("stack total"));
const price = sum(s.get("stack price"));
const paragraphs = s.list("paragraph").map(({ words }) => words);
const columns = cells(s.get("price table, columns"));
const prices = s.list("price row ").map(({ words }) => cells(words));
---

<section class="price" id="price" aria-labelledby="price-h">
  <div class="price__head" data-reveal>
    <p class="label">{s.get("label")}</p>
    <h2 class="h2" id="price-h">
      {s.get("heading")}
    </h2>
    <p class="price__lead">{paragraphs[0]}</p>
  </div>

  <div class="offer">
    <ol class="ledger" data-ledger data-reveal>
      {pieces.map(({ n, name, value }) => (
        <li>
          <span class="ledger__n">{n}</span>
          <span class="ledger__name">{name}</span>
          <span class="ledger__value">{value}</span>
        </li>
      ))}
    </ol>
    {products.map((item) => (
      <Product {...item} />
    ))}
    <Bonuses items={bonuses} />

    <div class="sum" data-reveal>
      <p class="sum__total">
        <span>{total[0]}</span>
        <b>{total[1]}</b>
      </p>
      <p class="sum__price">
        <span>{price[0]}</span>
        <b>{price[1]}</b>
      </p>
    </div>
    <div class="price__side">
      <p class="price__note" data-reveal>
        {s.get("line under the stack")}
      </p>
      {paragraphs.slice(1, 4).map((words) => (
        <p data-reveal>{words}</p>
      ))}
    </div>
  </div>

  <div class="sizes" data-reveal>
    <table class="sizes__table">
      <thead>
        <tr>
          {columns.map((name) => (
            <th scope="col">{name}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {prices.map((row) => (
          <tr>
            {row.map((cell, n) =>
              n === 0 ? <th scope="row">{cell}</th> : <td data-col={columns[n]}>{cell}</td>,
            )}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="sizes__founding">
      <span class="hang__dots" aria-hidden="true">
        {[0, 1, 2].map((n) => (
          <i data-taken={n >= FOUNDING_PLACES_LEFT ? "" : undefined} />
        ))}
      </span>
      {founding(s.get("founding line"))}
    </p>
    <div class="sizes__more">
      {paragraphs.slice(4).map((words) => (
        <p>{words}</p>
      ))}
    </div>
  </div>

  <Strip from={8} on="canvas" />
</section>
