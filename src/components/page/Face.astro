---
/** His face: a real photo when one is chosen (FOUNDER_PHOTO, or the one the import brought), his initials in a circle until then. */
import { page } from "../../content/site";
import { FOUNDER_PHOTO } from "../../config";
import { founderPhoto } from "../../content/proof";
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: extra } = Astro.props;
const photo = FOUNDER_PHOTO || founderPhoto();
---

{photo ? (
  <img class:list={["face", extra]} src={photo} alt="" width={size} height={size} />
) : (
  <span class:list={["face", extra]} aria-hidden="true">
    {page.founder.initials}
  </span>
)}
