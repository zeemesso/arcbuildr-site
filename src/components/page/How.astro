---
/**
 * 4. How it works: a diagram in a dark window (3 cards in, the hub, 2 cards out, joined by connectors),
 * then the five steps as numbered tabs: one is open at a time and they take turns. On a phone the
 * diagram stacks and every step is open. Without scripts every step is open too.
 */
import Marks from "./Marks.astro";
import { section } from "../../content/deck";
const s = section(4);
/** "Your interview. 45 minutes with me." → the first sentence leads, the rest explains. */
const lead = (words: string, mark = ". ") => {
  const cut = words.indexOf(mark);
  return [words.slice(0, cut + mark.length - 1), words.slice(cut + mark.length)] as const;
};
const inputs = s.list("input ").map(({ words }) => lead(words));
const hub = lead(s.get("hub"), ": ");
const outputs = s
  .list("output ")
  .map(({ slot, words }) => ({ marks: slot.includes("icons"), text: lead(words) }));
const steps = s.list("step ").map(({ words }) => lead(words));
// One small drawing per step: talk, write, script, film, review.
const icons = [
  "M5 6.5h14v9H11l-4 3.5v-3.5H5z",
  "M7 3.5h7l4 4V20.5H7zM14 3.5v4h4M10 12h5M10 15.5h5",
  "M4.5 19.5l1-4.5 9.5-9.5 3.5 3.5L9 18.5zM13 7.5l3.5 3.5",
  "M8 2.5h8a1.5 1.5 0 0 1 1.5 1.5v16a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.500 20V4A1.5 1.5 0 0 1 8 2.500zM12 15.500a3 3 0 1 0 0-6 3 3 0 0 0 0 6z",
  "M4 5.5h16v14H4zM4 9.500h16M8.500 3v4M15.500 3v4M8.500 14.500l2.500 2.500 4.500-5",
];
---

<section class="window window--night how" id="how" aria-labelledby="how-h">
  <div class="how__head">
    <p class="label" data-reveal>
      {s.get("label")}
    </p>
    <h2 class="h2" id="how-h" data-reveal>
      {s.get("heading")}
    </h2>
  </div>

  <div class="flow" data-reveal>
    <div class="flow__col flow__col--in">
      <p class="flow__label">{s.get("diagram, left label")}</p>
      <ul class="flow__cards">
        {inputs.map(([title, rest]) => (
          <li class="flow__card">
            <b>{title}</b> {rest}
          </li>
        ))}
      </ul>
    </div>
    <svg
      class="flow__pipes flow__pipes--in"
      viewBox="0 0 100 300"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M0 50 C55 50 45 150 100 150" />
      <path d="M0 150 L100 150" />
      <path d="M0 250 C55 250 45 150 100 150" />
      <path class="flow__run" d="M0 50 C55 50 45 150 100 150" />
      <path class="flow__run" d="M0 150 L100 150" />
      <path class="flow__run" d="M0 250 C55 250 45 150 100 150" />
    </svg>
    <div class="flow__col flow__col--hub">
      <p class="flow__label">{s.get("diagram, hub label")}</p>
      <p class="flow__hub">
        <b>{hub[0]}</b> {hub[1]}
      </p>
    </div>
    <svg
      class="flow__pipes flow__pipes--out"
      viewBox="0 0 100 300"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M0 150 C55 150 45 75 100 75" />
      <path d="M0 150 C55 150 45 225 100 225" />
      <path class="flow__run" d="M0 150 C55 150 45 75 100 75" />
      <path class="flow__run" d="M0 150 C55 150 45 225 100 225" />
    </svg>
    <div class="flow__col flow__col--out">
      <p class="flow__label">{s.get("diagram, right label")}</p>
      <ul class="flow__cards">
        {outputs.map(({ marks, text: [title, rest] }) => (
          <li class="flow__card flow__card--out">
            {marks && <Marks />}
            <span>
              <b>{title}</b> {rest}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <ol class="steps" data-steps data-active="1">
    {steps.map(([title, rest], n) => (
      <li class:list={["steps__step", { "is-on": n === 0 }]} data-reveal style={`--i:${n}`}>
        <h3 class="steps__h">
          <button type="button" aria-expanded="true" aria-controls={`step-${n + 1}`}>
            <span class="steps__top">
              <span class="steps__n">{String(n + 1).padStart(2, "0")}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={icons[n]} />
              </svg>
            </span>
            <span class="steps__t">{title}</span>
          </button>
        </h3>
        <p class="steps__text" id={`step-${n + 1}`}>
          {rest}
        </p>
        <i class="steps__bar" aria-hidden="true" />
      </li>
    ))}
  </ol>
</section>
