---
/**
 * 6. Who directs it: his photo on one side (his initials until a real photo exists), the words on the
 * other. No video here: the first screen's video carries who we are. An apply strip closes it.
 * The item that points to the work shows only while "The work" is on the page.
 */
import Strip from "./Strip.astro";
import { section } from "../../content/deck";
import { FOUNDER_PHOTO } from "../../config";
import { founderPhoto, workIsReady } from "../../content/proof";
import { page } from "../../content/site";
const s = section(6);
const photo = FOUNDER_PHOTO || founderPhoto();
const items = s
  .list("item ")
  .filter(({ slot }) => workIsReady() || !slot.includes("shown with section 7"))
  .map(({ words }) => words);
---

<section class="who" id="who" aria-labelledby="who-h">
  <div class="who__grid">
    <div class="who__photo" data-reveal data-who-photo>
      {photo ? (
        <img src={photo} alt="" loading="lazy" decoding="async" />
      ) : (
        <span class="face who__face" aria-hidden="true">
          {page.founder.initials}
        </span>
      )}
    </div>
    <div class="who__words">
      <p class="label" data-reveal>
        {s.get("label")}
      </p>
      <h2 class="h2" id="who-h" data-reveal>
        {s.get("heading")}
      </h2>
      {s.list("paragraph").map(({ words }) => (
        <p data-reveal>{words}</p>
      ))}
      <ol class="who__ways">
        {items.map((words, n) => (
          <li data-reveal style={`--i:${n}`}>
            <b aria-hidden="true">{n + 1}</b>
            <span>{words}</span>
          </li>
        ))}
      </ol>
      <p class="who__small" data-reveal>
        {s.get("small line")}
      </p>
    </div>
  </div>
  <Strip from={6} />
</section>
