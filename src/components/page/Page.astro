---
/**
 * The home page, section by section. The home page uses it as it is; the preview-only demo
 * (src/pages/demo/[film].astro) gives it a test film, so the video block can be seen before he films.
 */
import Home from "../../layouts/Home.astro";
import Bar from "./Bar.astro";
import First from "./First.astro";
import Wins from "./Wins.astro";
import Problem from "./Problem.astro";
import Beliefs from "./Beliefs.astro";
import How from "./How.astro";
import Get from "./Get.astro";
import Gallery from "./Gallery.astro";
import Packages from "./Packages.astro";
import Plain from "./Plain.astro";
import Bonuses from "./Bonuses.astro";
import Guarantee from "./Guarantee.astro";
import Fit from "./Fit.astro";
import Faq from "./Faq.astro";
import Apply from "./Apply.astro";
import Foot from "./Foot.astro";
import Application from "../application/Application.astro";
import { VSL_VIDEO } from "../../config";
interface Props {
  /** The sales video's file. The home page takes VSL_VIDEO; the demo gives its test film. */
  film?: string;
  noindex?: boolean;
}
const { film = VSL_VIDEO, noindex = false } = Astro.props;
---

<Home noindex={noindex}>
  <Bar slot="bar" />
  <First film={film} />
  <Wins />
  <Problem />
  <Beliefs />
  <How />
  <Get />
  <Gallery />
  <Packages />
  <Plain />
  <Bonuses />
  <Guarantee />
  <Fit />
  <Faq />
  <Apply />
  <Foot slot="after" />
  <Application slot="after" />
</Home>
