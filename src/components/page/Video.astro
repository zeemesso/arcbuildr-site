---
/**
 * A video slot. With a file it is a player; until he films it, a poster with his face and the deck's
 * line on who he is. No play button on the poster: there is nothing to play yet.
 */
import Face from "./Face.astro";
import { section } from "../../content/deck";
interface Props {
  src: string;
  /** What the video is, for a screen reader. */
  title: string;
  /** A line shown on the poster's corner (the deck's own words), such as its length. */
  note?: string;
}
const { src, title, note } = Astro.props;
const who = section(1).get("video, poster");
---

{src ? (
  <video class="video" controls playsinline preload="metadata" aria-label={title} src={src} />
) : (
  <div class="video video--poster" data-poster>
    <Face size={96} class="video__face" />
    <p class="video__who">{who}</p>
    {note && <p class="video__note">{note}</p>}
  </div>
)}
