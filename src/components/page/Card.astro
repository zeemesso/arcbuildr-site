---
/**
 * One card of "What you get": its number, when it arrives, the step of the Show it comes from, its
 * title, what it does, and its screen. The screen is a picture of the real document (src/content/proof.ts);
 * until that picture exists, the screen is the card's own title on a plain panel.
 */
import { section } from "../../content/deck";
import { CARD_PIECES, shot } from "../../content/proof";
interface Props {
  n: string;
  wide?: boolean;
}
const { n, wide = false } = Astro.props;
const s = section(5);
const key = `card ${n}`;
const title = s.get(`${key}, title`);
const picture = n in CARD_PIECES ? shot(CARD_PIECES[n as keyof typeof CARD_PIECES]) : null;
---

<li class:list={["card", { "card--wide": wide }]} data-reveal data-card={n}>
  <div class:list={["card__stage", { "card__stage--shot": picture }]}>
    <span class="card__n">{n}</span>
    {picture ? (
      <img
        src={picture.image}
        alt={picture.alt}
        width={picture.width}
        height={picture.height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <h3 class="card__h">{title}</h3>
    )}
  </div>
  <div class="card__text">
    {picture && <h3 class="card__h">{title}</h3>}
    <p class="card__meta">
      <span class="card__date">{s.get(`${key}, date`)}</span>
      <span class="card__from">{s.get(`${key}, from`)}</span>
    </p>
    <p class="card__body">{s.get(`${key}, body`)}</p>
  </div>
</li>
