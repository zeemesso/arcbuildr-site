---
/**
 * One card of "What you get": its screen, its number, its title, when it arrives, the step of the Show
 * it comes from and what it does. The screen is the default slot: a small drawing that moves, or the
 * picture of the real document once it exists (Get.astro chooses).
 */
import { section } from "../../content/deck";
interface Props {
  n: string;
  wide?: boolean;
}
const { n, wide = false } = Astro.props;
const s = section(5);
const key = `card ${n}`;
---

<li class:list={["card", { "card--wide": wide }]} data-reveal data-card={n}>
  <div class="card__stage">
    <slot />
  </div>
  <div class="card__text">
    <span class="card__n">{n}</span>
    <h3 class="card__h">{s.get(`${key}, title`)}</h3>
    <p class="card__meta">
      <span class="card__date">{s.get(`${key}, date`)}</span>
      <span class="card__from">{s.get(`${key}, from`)}</span>
    </p>
    <p class="card__body">{s.get(`${key}, body`)}</p>
  </div>
</li>
