---
import { sample } from "../content/site";
---

<div class="script-sheet">
  <div class="script-strip">
    <span class="kicker">{sample.doc.code}</span>
    <span class="stamp">{sample.stamp}</span>
  </div>
  <div class="script-heading flow">
    <h3>{sample.doc.title}</h3>
    <p class="mono muted">{sample.doc.meta.join(" · ")}</p>
  </div>
  <table class="script-table">
    <thead>
      <tr>
        <td></td>
        <th scope="col">{sample.doc.sayHead}</th>
        <th scope="col">{sample.doc.showHead}</th>
      </tr>
    </thead>
    <tbody>
      {sample.doc.rows.map((row) => (
        <tr>
          <th scope="row" class="mono">
            {row.t}
          </th>
          <td>{row.say}</td>
          <td class="show">
            <span class="kicker show-tag" aria-hidden="true">
              {sample.doc.showHead}
            </span>
            {row.show}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="script-caption flow">
    <p class="kicker">{sample.doc.captionLabel}</p>
    <p>{sample.doc.caption}</p>
  </div>
</div>
