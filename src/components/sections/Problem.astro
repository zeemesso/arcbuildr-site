---
import { problem } from "../../content/site";
const tiles = Array.from({ length: 12 });
---

<section class="sec problem" id="problem" aria-labelledby="problem-title">
  <h2 class="title title--long" id="problem-title">
    {problem.h2}
  </h2>
  <div class="problem__grid">
    <ul class="quotes">
      {problem.quotes.map((quote) => (
        <li class="quote" data-reveal>
          {quote}
        </li>
      ))}
    </ul>
    <div class="versus card" data-reveal role="img" aria-label={problem.picture.alt}>
      <div class="versus__side versus__side--posts">
        <div class="minigrid">
          {tiles.map(() => (
            <i />
          ))}
        </div>
        <p>{problem.picture.left}</p>
      </div>
      <div class="versus__side versus__side--season">
        <div class="minigrid">
          {tiles.map(() => (
            <i />
          ))}
        </div>
        <p>{problem.picture.right}</p>
      </div>
    </div>
  </div>
  <div class="cause" data-reveal>
    <p class="cause__lead">{problem.cause}</p>
    <ol class="cause__list">
      {problem.undecided.map((thing, i) => (
        <li style={`--i:${i}`}>{thing}</li>
      ))}
    </ol>
    <p class="cause__close">{problem.close}</p>
  </div>
</section>
