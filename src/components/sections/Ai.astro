---
import { ai } from "../../content/site";
const pages = Array.from({ length: 24 });
---

<section class="sec" id="ai" aria-labelledby="ai-title">
  <div class="ai__block" data-reveal>
    <h2 class="title" id="ai-title">
      {ai.h2}
    </h2>
    <p>{ai.body}</p>
    <div class="ai__same" aria-hidden="true">
      {pages.map((_, i) => (
        <i style={`--i:${i}`} />
      ))}
    </div>
  </div>
</section>
