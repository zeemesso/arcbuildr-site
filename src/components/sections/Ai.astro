---
import Section from "../Section.astro";
import { whyNotAi as content } from "../../content/site";
import type { SectionId } from "../../content/sections";

interface Props {
  id: SectionId;
}
const { id } = Astro.props;
---

<Section id={id} kicker={content.kicker} title={content.h2} shape="split">
  <p>{content.intro}</p>
  <ol class="two-columns points">
    {content.points.map((item) => (
      <li class="flow">
        <span class="mono">{item.n}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </li>
    ))}
  </ol>
</Section>
