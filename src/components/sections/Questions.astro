---
import { questions } from "../../content/site";
---

<section class="sec faq" id="questions" aria-labelledby="questions-title">
  <h2 class="title" id="questions-title">
    {questions.h2}
  </h2>
  <div class="faq__list">
    {questions.items.map((item) => (
      <details class="qa card" id={item.id}>
        <summary>
          {item.q}
          <span class="plus" aria-hidden="true" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>
