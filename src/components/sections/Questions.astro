---
import Section from "../Section.astro";
import { questions as content } from "../../content/site";
import type { SectionId } from "../../content/sections";

interface Props {
  id: SectionId;
}
const { id } = Astro.props;
---

<Section id={id} kicker={content.kicker} title={content.h2} shape="split">
  <div class="questions">
    {content.items.map((item, index) => (
      <details id={item.id} open={index === 0}>
        <summary>
          {item.q}
          <span class="plus" aria-hidden="true"></span>
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</Section>
