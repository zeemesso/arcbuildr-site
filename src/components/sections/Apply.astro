---
import logo from "../../data/logo.json";
import { apply } from "../../content/site";
import EntryBlock from "../EntryBlock.astro";
---

<section class="sec apply" id="apply" aria-labelledby="apply-title">
  <h2 class="title" id="apply-title">
    {apply.h2}
  </h2>
  <div class="apply__stack" data-reveal>
    <svg class="apply__arc" viewBox={logo.arc.viewBox} aria-hidden="true">
      <path
        d={logo.arc.d}
        pathLength="1"
        fill="none"
        stroke="currentColor"
        stroke-width={logo.arc.stroke}
        stroke-linecap="round"
      ></path>
    </svg>
    <EntryBlock id="bottom" />
  </div>
</section>
