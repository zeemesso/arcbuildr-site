---
import Section from "../Section.astro";
import { guarantee as content } from "../../content/site";
import type { SectionId } from "../../content/sections";

interface Props {
  id: SectionId;
}
const { id } = Astro.props;
---

<Section id={id} kicker={content.kicker} title={content.h2} shape="split">
  <p>{content.body}</p>
  <dl class="label-rows">
    {content.rows.map((row) => (
      <div>
        <dt>{row.label}</dt>
        <dd>{row.text}</dd>
      </div>
    ))}
  </dl>
  <div class="limit flow">
    <h3>{content.not.title}</h3>
    <p>{content.not.body}</p>
  </div>
</Section>
