---
import logo from "../../data/logo.json";
import { founder, hero } from "../../content/site";
import { FOUNDER_VIDEO } from "../../config";
import EntryBlock from "../EntryBlock.astro";
import VideoCard from "../VideoCard.astro";
---

<section class="hero" id="top">
  <svg class="hero__arc" viewBox={logo.arc.viewBox} aria-hidden="true">
    <path
      d={logo.arc.d}
      pathLength="1"
      fill="none"
      stroke="currentColor"
      stroke-width={logo.arc.stroke}
      stroke-linecap="round"
    ></path>
  </svg>
  <div class="hero__copy">
    <p class="who">{hero.who}</p>
    <h1>
      {hero.h1.map((line) => (
        <span class="line">
          <span>{line}</span>{" "}
        </span>
      ))}
    </h1>
    <p class="lede">{hero.lede}</p>
  </div>
  <EntryBlock id="top" />
  <VideoCard
    src={FOUNDER_VIDEO}
    alt={founder.alt}
    title={founder.video.title}
    length={founder.video.length}
    play={founder.video.play}
  >
    <h2>{founder.title}</h2>
    <p>{founder.body}</p>
  </VideoCard>
</section>
