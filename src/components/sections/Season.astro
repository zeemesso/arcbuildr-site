---
import { season } from "../../content/site";
import {
  arcRows,
  cycleMs,
  cycles,
  fillAt,
  heights,
  seasonKeyframes,
  seasonNames,
  setOff,
  walkMs,
} from "../../lib/arc";

/** Rows of public/sprites/zyade.png, top to bottom (scripts/sprites/build.mjs, OUTFITS). */
const sheet = ["own", "anime", "scifi", "western", "detective"];
/** The colour a season floods its block with. Each is dark enough for white text. */
const colour: Record<string, string> = {
  anime: "var(--color-clay)",
  scifi: "var(--color-sage)",
  western: "var(--color-taupe-deep)",
  detective: "var(--color-ink)",
};
// No script: picking a season is a radio, and :has() swaps the costume row, the colours and the
// animation names. New names restart the walk, so every pick plays the change and the walk again.
const css = [
  `.season__play{${seasonNames("own", false)}}`,
  seasonKeyframes("own"),
  ...season.seasons.map(
    ({ id }) =>
      `.season__play:has([value="${id}"]:checked){--row:${sheet.indexOf(id)};--tile:${colour[id]};--block:var(--tile);--on-block:var(--color-card);${seasonNames(id, true)}}` +
      seasonKeyframes(id),
  ),
].join("");
const stageVars = [
  `--walk:${walkMs}ms`,
  `--cycle:${cycleMs}ms`,
  `--cycles:${cycles}`,
  `--set-off:${setOff}`,
  `--w-ep:"${season.tag.episode}"`,
  `--w-of:"${season.tag.of}"`,
  `--w-day:"${season.tag.day}"`,
].join(";");
---

<section class="sec season" id="season" aria-labelledby="season-title">
  <div class="season__head">
    <h2 class="title" id="season-title">
      {season.h2}
    </h2>
    <p>{season.sub}</p>
  </div>
  <div class="season__play card" style={stageVars}>
    <fieldset class="chips">
      <legend class="vh">{season.legend}</legend>
      {season.seasons.map(({ id, label }) => (
        <label class={`chip chip--${id}`}>
          <input type="radio" name="season" value={id} />
          <span>{label}</span>
        </label>
      ))}
    </fieldset>
    <div class="stage" role="img" aria-label={season.alt}>
      <p class="tag" aria-hidden="true"></p>
      <div class="arc" aria-hidden="true" style={`--rows:${arcRows}`}>
        {heights.map((height, i) => (
          <i class="tile" style={`--c:${i + 1};--r:${arcRows - height};--f:${fillAt[i]}`} />
        ))}
        <div class="walker">
          <div class="sprite"></div>
          <div class="poof"></div>
        </div>
      </div>
    </div>
    <p class="season__caption">{season.caption}</p>
  </div>
</section>
<style is:inline set:html={css}></style>
