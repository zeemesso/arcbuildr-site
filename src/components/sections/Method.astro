---
import Section from "../Section.astro";
import { method as content } from "../../content/site";
import type { SectionId } from "../../content/sections";

interface Props {
  id: SectionId;
}
const { id } = Astro.props;
---

<Section id={id} kicker={content.kicker} title={content.h2} shape="stack">
  <p>{content.intro}</p>
  <ol class="method-steps">
    {content.steps.map((item) => (
      <li>
        <span class="mono">{item.n}</span>
        <h3>{item.plain}</h3>
        <div class="flow">
          <p class="kicker">{content.getLabel}</p>
          <p class="doc">{item.doc}</p>
          <p>{item.body}</p>
        </div>
        <div class="flow">
          <p class="kicker">{content.fixesLabel}</p>
          {item.fixes.map((quote) => (
            <p class="quote">{quote}</p>
          ))}
        </div>
      </li>
    ))}
  </ol>
  <div class="limit flow">
    <h3>{content.order.title}</h3>
    <p>{content.order.body}</p>
  </div>
</Section>
