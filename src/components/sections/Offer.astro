---
import { offer } from "../../content/site";
const weeks = Array.from({ length: 12 }, (_, i) => i + 1);
const callWeeks = [4, 8];
const pinsIn = (week: number) => offer.cards.filter((card) => Math.ceil(card.day / 7) === week);
/** The legend's three keys, in the order of offer.strip.legend. */
const keys = ["pin", "mon", "call"];
const marks = Array.from({ length: 6 });
---

<section class="sec" id="offer" aria-labelledby="offer-title">
  <h2 class="title" id="offer-title">
    {offer.h2}
  </h2>
  <div class="weeks card" data-reveal>
    <div role="img" aria-label={offer.strip.alt}>
      <ol class="weeks__row">
        {weeks.map((week, i) => (
          <li style={`--i:${i}`}>
            <span class="weeks__n" />
            <span class="weeks__pins">
              {pinsIn(week).map((card) => (
                <i style={`--hue:var(--hue-${card.hue})`} />
              ))}
              {callWeeks.includes(week) && <i class="is-call" />}
            </span>
            <span class="weeks__mon" />
          </li>
        ))}
      </ol>
    </div>
    <ul class="weeks__legend">
      {offer.strip.legend.map((text, i) => (
        <li>
          <i class={`key key--${keys[i]}`} />
          {text}
        </li>
      ))}
    </ul>
  </div>
  <ol class="deliver">
    {offer.cards.map((card, i) => (
      <li
        class={`dcard card dcard--${card.art}`}
        data-reveal
        style={`--hue:var(--hue-${card.hue});--i:${i % 3}`}
      >
        <p class="when">
          <span>{offer.when}</span>
          <b>{card.day}</b>
        </p>
        <h3>
          {card.decides && <i class="dcard__n" data-n={card.decides} aria-hidden="true" />}
          {card.title}
        </h3>
        <p class="dcard__body">{card.body}</p>
        <div class={`art art--${card.art}`} aria-hidden="true">
          {marks.map(() => (
            <i />
          ))}
        </div>
      </li>
    ))}
  </ol>
  <div class="offer">
    <div class="sizebox card" data-reveal>
      <ul class="sizes">
        {offer.sizes.rows.map((row, i) => (
          <li class:list={["size", row.pick && "is-pick"]} style={`--i:${i}`}>
            {row.pick && <p class="size__pick">{offer.sizes.pickTag}</p>}
            <p class="size__n">
              <b>{row.n}</b>
              <span>{offer.sizes.unit}</span>
            </p>
            <p class="size__rhythm">{row.rhythm}</p>
            <p class="size__by">{row.by}</p>
          </li>
        ))}
      </ul>
      <p class="sizes__note">{offer.sizes.note}</p>
    </div>
    <div class="price card" data-reveal>
      <p class="price__label">{offer.price.label}</p>
      <p class="price__fig">
        <b>{offer.price.from}</b>
        <span>{offer.price.join}</span>
        <b>{offer.price.to}</b>
        <span>{offer.price.unit}</span>
      </p>
      <p class="price__line">{offer.price.line}</p>
    </div>
  </div>
</section>
