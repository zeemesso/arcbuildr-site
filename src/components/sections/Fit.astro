---
import Section from "../Section.astro";
import { fit as content } from "../../content/site";
import type { SectionId } from "../../content/sections";

interface Props {
  id: SectionId;
}
const icons = [
  ["......X", ".....XX", "X...XX.", "XX.XX..", ".XXX...", "..X....", "......."],
  ["X.....X", "XX...XX", ".XX.XX.", "..XXX..", ".XX.XX.", "XX...XX", "X.....X"],
];
const { id } = Astro.props;
---

<Section id={id} kicker={content.kicker} title={content.h2} shape="stack">
  <div class="two-columns">
    {[content.yes, content.no].map((part, index) => (
      <div class:list={["flow", { muted: index === 1 }]}>
        <h3>{part.title}</h3>
        <ul class="fit-list">
          {part.items.map((item) => (
            <li>
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                aria-hidden="true"
                shape-rendering="crispEdges"
                fill="currentColor"
              >
                {icons[index].map((row, y) =>
                  [...row].map(
                    (pixel, x) =>
                      pixel === "X" && <rect x={x * 2} y={y * 2} width="2" height="2" />,
                  ),
                )}
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
