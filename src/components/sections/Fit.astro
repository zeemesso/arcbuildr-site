---
import { fit } from "../../content/site";
import Mark from "../Mark.astro";
---

<section class="sec" id="fit" aria-labelledby="fit-title">
  <h2 class="title" id="fit-title">
    {fit.h2}
  </h2>
  <div class="fit__grid">
    <div class="fitcard fitcard--yes" data-reveal>
      <h3>{fit.yes.title}</h3>
      <ul>
        {fit.yes.items.map((item) => (
          <li>
            <Mark />
            {item}
          </li>
        ))}
      </ul>
    </div>
    <div class="fitcard fitcard--no" data-reveal style="--i:1">
      <h3>{fit.no.title}</h3>
      <ul>
        {fit.no.items.map((item) => (
          <li>
            <Mark no />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
