---
import { proof } from "../../content/site";
import ScriptDoc from "../ScriptDoc.astro";
const lines = Array.from({ length: 7 });
---

<section class="sec" id="proof" aria-labelledby="proof-title">
  <h2 class="title title--long" id="proof-title">
    {proof.h2}
  </h2>
  <div class="proof__grid">
    <article class="pcard card pcard--sample" data-reveal>
      <p class="pcard__label">{proof.sample.label}</p>
      <h3>{proof.sample.title}</h3>
      <p>{proof.sample.intro}</p>
      <ScriptDoc />
      <a class="more" href={proof.sample.link.href}>
        {proof.sample.link.text}
      </a>
    </article>
    <article class="pcard pcard--audit" data-reveal>
      <p class="pcard__label">{proof.audit.label}</p>
      <h3>{proof.audit.title}</h3>
      <p>{proof.audit.body}</p>
      <div class="page-art" aria-hidden="true">
        {lines.map(() => (
          <i />
        ))}
      </div>
    </article>
    <article class="pcard card pcard--refund" data-reveal>
      <p class="pcard__label">{proof.refund.label}</p>
      <h3>{proof.refund.title}</h3>
      <ol class="figs">
        {proof.refund.steps.map((step) => (
          <li>
            <b>{step.figure}</b>
            <span>{step.text}</span>
          </li>
        ))}
      </ol>
      <p class="pcard__then">{proof.refund.rewrites}</p>
      <p class="pcard__not">{proof.refund.not}</p>
    </article>
  </div>
</section>
