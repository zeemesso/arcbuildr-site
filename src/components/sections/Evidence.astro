---
import { evidence } from "../../content/site";
const hues = ["sage", "clay", "ink", "accent"];
---

<section class="sec" id="evidence" aria-labelledby="evidence-title">
  <h2 class="title" id="evidence-title">
    {evidence.h2}
  </h2>
  <p class="evidence__line">{evidence.line}</p>
  <details class="research">
    <summary>
      <span class="plus" aria-hidden="true"></span>
      {evidence.summary}
    </summary>
    <ul class="findings">
      {evidence.findings.map((finding, i) => (
        <li class="finding card" id={finding.id} style={`--hue:var(--hue-${hues[i]})`}>
          <b>{finding.figure}</b>
          <p>{finding.claim}</p>
          <cite>{finding.source}</cite>
        </li>
      ))}
    </ul>
    <p class="limit">{evidence.limit}</p>
  </details>
</section>
