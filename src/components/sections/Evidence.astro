---
import Section from "../Section.astro";
import { evidence as content } from "../../content/site";
import type { SectionId } from "../../content/sections";

interface Props {
  id: SectionId;
}
const { id } = Astro.props;
---

<Section id={id} kicker={content.kicker} title={content.h2} shape="split">
  <p>{content.intro}</p>
  <div>
    {content.findings.map((item) => (
      <article class="finding flow">
        <h3>{item.claim}</h3>
        <p>{item.detail}</p>
        <p class="why">
          <span class="kicker">{content.whyLabel}</span> {item.why}
        </p>
        <p class="kicker muted">{item.source}</p>
      </article>
    ))}
  </div>
  <div class="limit flow">
    <h3>{content.limit.title}</h3>
    <p>{content.limit.body}</p>
  </div>
  <p>{content.role}</p>
</Section>
