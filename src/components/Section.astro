---
import type { SectionId } from "../content/sections";
interface Props {
  id: SectionId;
  kicker: string;
  title: string;
  shape?: "split" | "stack";
}
const { id, kicker, title, shape = "split" } = Astro.props;
---

<section id={id} class={`wrap section ${shape}`} aria-labelledby={`${id}-title`}>
  <div class="section-heading">
    <p class="kicker">{kicker}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    <slot name="picture" />
  </div>
  <div class="section-content flow">
    <slot />
  </div>
</section>
