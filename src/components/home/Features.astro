---
/**
 * "Five tools you keep", one per card: an animated screen of our own product on one side,
 * a number, a heading and one sentence on the other. Every screen is tagged a sample.
 */
import Profile from "./screens/Profile.astro";
import Script from "./screens/Script.astro";
import Setup from "./screens/Setup.astro";
import Editor from "./screens/Editor.astro";
import Files from "./screens/Files.astro";
import { home } from "../../content/site";
const { features } = home;
const screens = { profile: Profile, script: Script, setup: Setup, editor: Editor, files: Files };
---

<section class="sheet features" id="tools" aria-labelledby="feat-h" data-reveal>
  <div class="spine spine--through" aria-hidden="true"></div>
  <h2 class="h2" id="feat-h">
    {features.h2}
  </h2>
  <p class="features__note">{features.note}</p>
  {features.cards.map((card, i) => {
    const Screen = screens[card.id as keyof typeof screens];
    return (
      <article class="feat" data-reveal>
        <div class="feat__screen">
          <Screen />
        </div>
        <div class="feat__words">
          <p class="feat__n" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </p>
          <h3 class="feat__h">{card.h3}</h3>
          <p class="feat__p">{card.body}</p>
        </div>
      </article>
    );
  })}
</section>
