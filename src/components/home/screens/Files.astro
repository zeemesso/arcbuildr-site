---
/** Screen 5: a new file arrives with its first lines, and is added in 3 steps. */
import Shot from "./Shot.astro";
import Tick from "./Tick.astro";
import { home } from "../../../content/site";
const s = home.features.screens.files;
---

<Shot loop={11000} alt={s.alt} source={s.source} length={s.length} meter={1600}>
  <div class="addon" data-at="600" data-fx="drop">
    <span class="addon__tag">{s.tag}</span>
    <dl>
      {s.lines.map((line, k) => (
        <div data-at={1100 + k * 200} data-fx="rise">
          <dt>{line.k}</dt>
          <dd>{line.v}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="add3">
    <span class="shot__label" data-at="2900" data-fx="fade">
      {s.stepsLabel}
    </span>
    <ol>
      {s.steps.map((step, k) => (
        <li class="add3__step" data-at={3300 + k * 900}>
          <b>{k + 1}</b>
          <span>{step}</span>
          <span class="shot__tick">
            <Tick />
          </span>
        </li>
      ))}
    </ol>
  </div>
  <p class="addon__end">
    <span class="shot__badge" data-at="6400" data-fx="pop">
      <Tick />
      {s.added}
    </span>
    <span class="shot__label" data-at="7100" data-fx="fade">
      {s.next}
    </span>
  </p>
</Shot>
