---
/** Words that arrive one after another, as if typed. They wrap like any text. */
interface Props {
  text: string;
  at: number;
}
const { text, at } = Astro.props;
const words = text.split(" ");
---

<span class="typed" data-at={at}>
  {words.map((word, k) => (
    <i style={`--k:${k}`}>{k ? ` ${word}` : word}</i>
  ))}
</span>
