---
/** Screen 4: a clip is dropped in, the cut list shows what goes, and the export waits for a yes. */
import Shot from "./Shot.astro";
import Tick from "./Tick.astro";
import Typed from "./Typed.astro";
import { home } from "../../../content/site";
const s = home.features.screens.editor;
const at = (k: number) => 2300 + k * 350;
---

<Shot loop={11000} alt={s.alt} source={s.source} length={s.length} meter={2000}>
  <p class="said" data-at="500" data-fx="rise">
    <Typed text={s.typed} at={800} />
  </p>
  <div class="cut" data-at="1700" data-fx="rise">
    <header class="cut__head">
      <b>{s.head}</b>
      <span class="shot__label">{s.summary}</span>
    </header>
    <div class="cut__track">
      {s.cuts.map((cut, k) => (
        <i class="cut__gap" style={`--a:${cut.from}%;--b:${cut.to}%`} data-at={at(k)} />
      ))}
      <i class="cut__keep"></i>
      <i class="cut__run" data-at="6500"></i>
    </div>
    <ol class="cut__rows">
      {s.cuts.map((cut, k) => (
        <li data-at={at(k)} data-fx="rise">
          <b>{k + 1}</b>
          <span>{cut.at}</span>
          <em>{cut.what}</em>
        </li>
      ))}
    </ol>
    <p class="cut__never" data-at="3900" data-fx="fade">
      <svg viewBox="0 0 24 24">
        <rect x="5" y="11" width="14" height="9" rx="2"></rect>
        <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
      </svg>
      {s.never}
    </p>
  </div>
  <div class="shot__ask" data-at="4700" data-fx="rise">
    <span class="shot__ask-text">{s.ask}</span>
    <span class="shot__btn" data-at="6300">
      <span class="shot__btn-a">{s.yes}</span>
      <span class="shot__btn-b">
        <Tick />
        {s.done}
      </span>
    </span>
  </div>
</Shot>
