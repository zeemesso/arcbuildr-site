---
/** Screen 2: one typed idea becomes 3 angles, then a script with its 10 checks. */
import Shot from "./Shot.astro";
import Tick from "./Tick.astro";
import Typed from "./Typed.astro";
import { home } from "../../../content/site";
const s = home.features.screens.script;
---

<Shot loop={12000} alt={s.alt} source={s.source} length={s.length} meter={1800}>
  <p class="said" data-at="500" data-fx="rise">
    <Typed text={s.idea} at={700} />
  </p>
  <div class="angles">
    <span class="shot__label" data-at="2500" data-fx="fade">
      {s.anglesLabel}
    </span>
    <ol>
      {s.angles.map((angle, k) => (
        <li class="angle" data-at={2600 + k * 140} data-fx="rise">
          <b>{k + 1}</b>
          <span>{angle}</span>
          {k === 0 && <i class="angle__pick" data-at="3800" />}
        </li>
      ))}
    </ol>
  </div>
  <div class="draft" data-at="4500" data-fx="rise">
    <b>{s.title}</b>
    <span class="shot__label">{s.meta}</span>
    <p>
      <span class="shot__label">{s.openingLabel}</span>
      {s.opening}
    </p>
  </div>
  <div class="checks">
    <span class="shot__label" data-at="5300" data-fx="fade">
      {s.checksLabel}
    </span>
    <ul>
      {s.checks.map((check, k) => (
        <li data-at={5500 + k * 150} data-fx="pop">
          <Tick />
          {check}
        </li>
      ))}
    </ul>
    <p class="checks__end">
      <span data-at="7200" data-fx="fade">{`${s.count}: ${s.pass}`}</span>
      <span class="shot__badge" data-at="7600" data-fx="pop">
        <Tick />
        {s.ready}
      </span>
    </p>
  </div>
</Shot>
