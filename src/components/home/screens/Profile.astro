---
/** Screen 1: the profile is written from the interview, section by section, then saved. */
import Shot from "./Shot.astro";
import Tick from "./Tick.astro";
import { home } from "../../../content/site";
const s = home.features.screens.profile;
const rowAt = (k: number) => 600 + k * 420;
---

<Shot loop={10000} alt={s.alt} source={s.source} length={s.length}>
  <header class="shot__head">
    <svg viewBox="0 0 24 24">
      <path d="M6 3h8l4 4v14H6z"></path>
      <path d="M14 3v4h4M9 12h6M9 16h6"></path>
    </svg>
    <b>{s.file}</b>
    <span class="shot__badge" data-at="2900" data-fx="pop">
      <Tick />
      {s.badge}
    </span>
  </header>
  <ul class="shot__rows">
    {s.rows.map((row, k) => (
      <li class="shot__row" data-at={rowAt(k)}>
        <span class="shot__label">{row.label}</span>
        <span class="shot__value">
          <span class="shot__text">{row.value}</span>
          <span class="shot__bar" />
        </span>
        <span class="shot__tick">
          <Tick />
        </span>
      </li>
    ))}
  </ul>
  <div class="shot__ask" data-at="3600" data-fx="rise">
    <span class="shot__ask-text">{s.ask}</span>
    <span class="shot__btn" data-at="5200">
      <span class="shot__btn-a">{s.yes}</span>
      <span class="shot__btn-b">
        <Tick />
        {s.saved}
      </span>
    </span>
  </div>
</Shot>
