---
/** Five questions. Every answer is closed on load. */
import { home } from "../../content/site";
const { faq } = home;
---

<section class="sheet faq" id="questions" aria-labelledby="faq-h" data-reveal>
  <h2 class="h2" id="faq-h">
    {faq.h2}
  </h2>
  <div class="faq__list">
    {faq.items.map((item, i) => (
      <details class="faq__item" id={item.id} style={`--i:${i}`}>
        <summary>
          <span>{item.q}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>
