---
/** The end of the page: the same two fields. */
import Entry from "./Entry.astro";
import { home } from "../../content/site";
const { book } = home;
---

<section class="sheet sheet--dark book" id="apply" aria-labelledby="book-h" data-reveal>
  <h2 class="h2" id="book-h">
    {book.h2}
  </h2>
  <p class="lede">{book.body}</p>
  <Entry />
</section>
