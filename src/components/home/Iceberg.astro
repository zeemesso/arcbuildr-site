---
/** The iceberg. Depth is time: three free things above the line, Season One below it, day by day. */
import { home } from "../../content/site";
const { iceberg } = home;
/** Each row is one band. Width narrows with depth to a point; the centre wanders a little. */
const n = iceberg.rows.length;
const wobble = [0, 3, -2, 4, 1, -3, 2, -1, 0, 1, -2, 0];
const band = (i: number) => {
  const top = 1 - (i / n) * 0.94;
  const bottom = i === n - 1 ? 0.02 : 1 - ((i + 1) / n) * 0.94;
  return `--i:${i};--t:${(top * 50).toFixed(2)}%;--b:${(bottom * 50).toFixed(2)}%;--c:${50 + wobble[i % wobble.length]!}%;--c2:${50 + wobble[(i + 1) % wobble.length]!}%;--d:${Math.round((i / Math.max(1, n - 1)) * 100)}%`;
};
---

<section class="sheet iceberg" aria-labelledby="ice-h" data-reveal>
  <div class="spine spine--through" aria-hidden="true"></div>
  <h2 class="h2" id="ice-h">
    {iceberg.h2}
  </h2>
  <div class="berg">
    <div class="berg__tip">
      <span class="berg__peak" aria-hidden="true">
        <span></span>
      </span>
      <div class="berg__top">
        <span class="berg__free">{iceberg.freeLabel}</span>
        <ul class="berg__chips">
          {iceberg.free.map((item, i) => (
            <li class="chip chip--free" style={`--i:${i}`}>
              {item.href ? <a href={item.href}>{item.text}</a> : item.text}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="berg__water">
      <span class="berg__line">{iceberg.waterline}</span>
    </div>
    {/* Phones: the iceberg is one picture, and the list sits under it with a colour key per band. */}
    <div class="berg__art" aria-hidden="true">
      <span class="berg__art-peak">
        <span></span>
      </span>
      <span class="berg__art-mass">
        {iceberg.rows.map((_, i) => (
          <i style={band(i)} />
        ))}
      </span>
    </div>
    <p class="berg__below">
      <span>{iceberg.below}</span>
      <strong>{iceberg.waterline}</strong>
    </p>
    <ol class="berg__mass" data-mask>
      {iceberg.rows.map((row, i) => (
        <li class="berg__row" style={band(i)}>
          <span class="berg__when">{row.when}</span>
          <span class="berg__what">{row.what}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
