---
/** What the client installs, for three kinds of client. One tab is open; the other two are read when picked. */
import { home } from "../../content/site";
const { install } = home;
---

<section class="sheet install" aria-labelledby="install-h" data-reveal>
  <h2 class="h2" id="install-h">
    {install.h2}
  </h2>
  <p class="lede">{install.body}</p>
  <div class="tabs" data-tabs>
    <div class="tabs__list" role="tablist" aria-labelledby="install-h">
      <span class="tabs__thumb" aria-hidden="true"></span>
      {install.tabs.map((tab, i) => (
        <button
          class="tabs__tab"
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))}
    </div>
    {install.tabs.map((tab, i) => (
      <div
        class="tabs__panel"
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        data-label={tab.label}
        hidden={i !== 0}
      >
        <ol class="stepsl">
          {tab.steps.map((step, k) => (
            <li style={`--i:${k}`}>
              <b aria-hidden="true">{k + 1}</b>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</section>
