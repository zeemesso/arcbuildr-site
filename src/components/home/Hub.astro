---
/** The diagram: four documents in, your profile in the middle, three uses out. */
import { home } from "../../content/site";
const { hub } = home;
---

<section class="sheet sheet--dark hub" aria-labelledby="hub-h" data-reveal>
  <div class="spine spine--through" aria-hidden="true"></div>
  <h2 class="h2" id="hub-h">
    {hub.h2}
  </h2>
  <p class="hub__body">{hub.body}</p>
  <div class="hub__map" data-map>
    <svg class="hub__wires" aria-hidden="true">
      <g></g>
    </svg>
    <div class="hub__side">
      <p class="hub__tag" id="hub-in">
        {hub.inLabel}
      </p>
      <ol class="hub__col hub__col--in" aria-labelledby="hub-in">
        {hub.inputs.map((title, i) => (
          <li class="node node--in" data-from style={`--i:${i}`}>
            <span class="node__title">{title}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="hub__core" data-core>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3h8l4 4v14H6z"></path>
        <path d="M14 3v4h4M9 12h6M9 16h6"></path>
      </svg>
      <span class="hub__core-title">{hub.core}</span>
    </div>
    <div class="hub__side">
      <p class="hub__tag" id="hub-out">
        {hub.outLabel}
      </p>
      <ol class="hub__col hub__col--out" aria-labelledby="hub-out">
        {hub.outputs.map((title, i) => (
          <li class="node node--out" data-to style={`--i:${i}`}>
            <span class="node__title">{title}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
