---
/** The two fields that open the application. Used at the top of the page and at its end. */
import { entry } from "../../content/site";
import { APPLICATION_MODE, APPLICATION_URL, BOOKING_URL } from "../../config";
interface Props {
  /** Entrance order on the first screen. Left out at the end of the page. */
  enter?: number;
}
const { enter } = Astro.props;
// With scripts running, the form opens the application. Without them it still leads somewhere useful:
// the booking page with the name and email filled ("native"), or the hosted form ("embed").
const fallback = APPLICATION_MODE === "native" ? BOOKING_URL : APPLICATION_URL;
---

<form
  class="entry"
  action={fallback}
  novalidate
  data-apply-entry
  data-enter={enter === undefined ? undefined : ""}
  style={enter === undefined ? undefined : `--i:${enter}`}
>
  <label class="entry__field">
    <span class="sr-only">{entry.name}</span>
    <input
      name="name"
      autocomplete="given-name"
      autocapitalize="words"
      placeholder={entry.name}
      enterkeyhint="next"
      maxlength="200"
    />
    <span class="entry__err" data-entry-err role="alert"></span>
  </label>
  <label class="entry__field">
    <span class="sr-only">{entry.email}</span>
    <input
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      autocapitalize="none"
      spellcheck="false"
      placeholder={entry.email}
      enterkeyhint="go"
      maxlength="320"
    />
    <span class="entry__err" data-entry-err role="alert"></span>
  </label>
  <button class="btn" type="submit">
    <span>{entry.button}</span>
  </button>
</form>
