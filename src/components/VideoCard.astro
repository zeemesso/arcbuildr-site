---
/**
 * A video slot. Until `src` is set it is a poster: the pixel Zyade on a block of brand colour.
 * With `src` the poster gets a play button, and the video element is only made when it is pressed,
 * so the page costs a phone no video data. Without JavaScript the button opens the file itself.
 */
interface Props {
  src: string;
  alt: string;
  title: string;
  length: string;
  play: string;
}
const { src, alt, title, length, play } = Astro.props;
---

<figure class="video card">
  <div class="video__poster">
    <span class="video__zyade" role="img" aria-label={alt}></span>
    {src && (
      <a class="video__play" href={src} aria-label={play} data-play data-title={title}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 6.2v11.6a1 1 0 0 0 1.5.9l9.6-5.8a1 1 0 0 0 0-1.8l-9.6-5.8a1 1 0 0 0-1.5.9z" />
        </svg>
      </a>
    )}
  </div>
  {(Astro.slots.has("default") || src) && (
    <figcaption>
      <slot />
      {src && (
        <p class="video__meta">
          <b>{title}</b>
          <span>{length}</span>
        </p>
      )}
    </figcaption>
  )}
</figure>
{src && <script is:inline>
  for (const link of document.querySelectorAll("[data-play]")) {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const film = document.createElement("video");
      film.className = "video__film";
      film.src = link.href;
      film.controls = true;
      film.playsInline = true;
      film.setAttribute("aria-label", link.dataset.title);
      link.closest("figure").classList.add("is-playing");
      link.replaceWith(film);
      film.focus();
      film.play().catch(() => {});
    });
  }
</script>}
