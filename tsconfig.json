{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "tests", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules"]
}
